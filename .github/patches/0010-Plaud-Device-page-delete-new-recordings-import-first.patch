 web/src/i18n/fr/devices.ts         |  6 +++
 web/src/i18n/fr/workspace.ts       |  1 +
 web/src/lib/api.ts                 |  5 ++-
 web/src/pages/DesktopPlaud.tsx     | 65 ++++++++++++++++++++++--------
 8 files changed, 85 insertions(+), 24 deletions(-)

diff --git a/src/api/plaud-delete-route.test.ts b/src/api/plaud-delete-route.test.ts
index 65fc042..f394116 100644
--- a/src/api/plaud-delete-route.test.ts
+++ b/src/api/plaud-delete-route.test.ts
@@ -11,4 +11,6 @@ test('delete from the recorder is refused unless the desktop app calls over loop
   expect(refused.status).toBe(403);
   expect((await refused.json()).error).toContain('desktop app');
   expect((await post({ sessionId: 1, confirm: true }, { 'X-OpenPlod-Token': 'phone-token' })).status).toBe(403);
+  // A delete without a saved copy is refused the same way, before its own confirmation is even read.
+  expect((await post({ sessionId: 1, confirm: true, withoutCopy: true, confirmPermanentLoss: true })).status).toBe(403);
 });
diff --git a/src/api/plaud.ts b/src/api/plaud.ts
index 3cb3f7d..2eff2d8 100644
--- a/src/api/plaud.ts
+++ b/src/api/plaud.ts
@@ -106,16 +106,19 @@ app.post('/device-delete', async c => {
   // or MCP using OPENPLOD_API_TOKEN, or a port-forwarded client that merely looks local.
   const caller = principalOf(c)?.kind;
   if (!localOwner(c) || (caller !== 'desktop' && caller !== 'open')) return c.json({ success: false, error: 'Deleting from the recorder must happen in the OpenPlod desktop app.' }, 403);
-  let body: { sessionId?: unknown; confirm?: unknown };
+  let body: { sessionId?: unknown; confirm?: unknown; withoutCopy?: unknown; confirmPermanentLoss?: unknown };
   try { body = await c.req.json(); } catch { body = {}; }
   if (body.confirm !== true || !Number.isSafeInteger(body.sessionId)) return c.json({ success: false, error: 'A session ID and delete confirmation are required' }, 400);
+  // Deleting a recording that is not in the vault needs its own, separate confirmation.
+  const withoutCopy = body.withoutCopy === true;
+  if (withoutCopy && body.confirmPermanentLoss !== true) return c.json({ success: false, error: 'Deleting without a saved copy needs confirmation that the audio will be lost' }, 400);
   if (importJob?.state === 'running') return c.json({ success: false, error: 'A Plaud import is running. Delete after it finishes.' }, 409);
   try {
     const result = await deleteDirectPlaudRecording(body.sessionId as number, async sourceRecordingId => {
       const rows = await db.select({ id: recordings.id, filePath: recordings.filePath, sourceRecordingId: recordings.sourceRecordingId, retentionState: recordings.retentionState })
         .from(recordings).where(and(eq(recordings.sourceProvider, 'plaud'), eq(recordings.sourceRecordingId, sourceRecordingId)));
       return rows.find(row => row.retentionState === 'active') ?? rows[0];
-    });
+    }, { withoutCopy });
     return c.json({ success: true, data: result });
   } catch (error) {
     return c.json({ success: false, error: error instanceof Error ? error.message : 'Delete from the recorder failed' }, 409);
diff --git a/src/sync/plaud-direct.ts b/src/sync/plaud-direct.ts
index 26bdb4c..470439a 100644
--- a/src/sync/plaud-direct.ts
+++ b/src/sync/plaud-direct.ts
@@ -74,15 +74,17 @@ export async function readDirectPlaudRecordings() {
  * Deletes one recording from the recorder, only after verifyVaultCopy proves the vault holds it
  * whole, then lists again to confirm it is gone. Returns alreadyGone when the device no longer
  * lists it (for example after a retry following a dropped connection).
+ * withoutCopy skips the vault check: the user chose "Delete without saving" after a warning that
+ * the audio cannot be recovered. Only the desktop route passes it, and only with its own confirmation.
  */
 export async function deleteDirectPlaudRecording(sessionId: number,
-  findRecording: (sourceRecordingId: string) => Promise<VaultRecording | undefined>) {
+  findRecording: (sourceRecordingId: string) => Promise<VaultRecording | undefined>, options: { withoutCopy?: boolean } = {}) {
   if (!Number.isSafeInteger(sessionId) || sessionId < 0 || sessionId > 0xffffffff) throw new Error('Invalid Plaud session ID');
   return withDevice(async (connection, identity) => {
     const before = await listPlaudSessions(connection);
     const target = before.find(session => session.sessionId === sessionId);
     if (!target) return { sessionId, deleted: false, alreadyGone: true, remaining: before.length };
-    await verifyVaultCopy({ serial: identity.serial, session: target, libraryDirectory: resolve(process.env.OPENPLOD_LIBRARY_PATH || './data/recordings'),
+    if (options.withoutCopy !== true) await verifyVaultCopy({ serial: identity.serial, session: target, libraryDirectory: resolve(process.env.OPENPLOD_LIBRARY_PATH || './data/recordings'),
       recording: await findRecording(`${identity.serial}:${sessionId}`) });
     await deletePlaudSession(connection, sessionId);
     const after = await listPlaudSessions(connection);
diff --git a/web/src/components/Layout.tsx b/web/src/components/Layout.tsx
index 92e2a54..967c511 100644
--- a/web/src/components/Layout.tsx
+++ b/web/src/components/Layout.tsx
@@ -95,6 +95,19 @@ export function Layout() {
     };
   }, []);
 
+  // The installed app's version (from the desktop shell), which a release can set apart from the
+  // web package's own version number. Falls back to the web build's version elsewhere.
+  const [appVersion, setAppVersion] = useState(buildInfo.version);
+  useEffect(() => {
+    if (runtime.mode !== "desktop") return;
+    let disposed = false;
+    void import("@tauri-apps/api/app")
+      .then(({ getVersion }) => getVersion())
+      .then((version) => { if (!disposed) setAppVersion(version); })
+      .catch(() => {});
+    return () => { disposed = true; };
+  }, [runtime.mode]);
+
   useLayoutEffect(() => {
     pageScrollRef.current?.scrollTo({ top: 0 });
   }, [location.pathname]);
@@ -376,9 +389,9 @@ export function Layout() {
                 <Brand />
               </div>
               <div className="workspace-footer-links">
-                <span title={`OpenPlod ${buildInfo.version} / ${buildInfo.builtAt}`}>
+                <span title={`OpenPlod ${appVersion} / ${buildInfo.builtAt}`}>
                   <i />
-                  {t("Build {label}", { label: buildLabel })}
+                  {t("v{version} · Build {label}", { version: appVersion, label: buildLabel })}
                 </span>
                 <Smartphone />
                 <NavLink to="/developer">API</NavLink>
