 const sessionDate = (session: DeviceRecording) => formatDate(session.sessionId * 1000, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' })
 
+// Each Bluetooth action opens and closes its own connection, so the page keeps the last check
+// here while the app runs. Leaving and reopening the page then shows it instead of "Not connected".
+let lastCheck: { status: PlaudStatus | null; sessions: DeviceRecording[] | null; checkedAt: Date | null } = { status: null, sessions: null, checkedAt: null }
+type DeleteMode = 'verified' | 'importFirst' | 'withoutCopy'
+
 export function DesktopPlaud() {
-  const [status, setStatus] = useState<PlaudStatus | null>(null)
+  const [status, setStatus] = useState<PlaudStatus | null>(lastCheck.status)
