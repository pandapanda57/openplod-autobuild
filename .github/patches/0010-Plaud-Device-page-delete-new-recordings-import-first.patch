diff --git a/web/src/lib/api.ts b/web/src/lib/api.ts
index 8d86554..c3d6e29 100644
--- a/web/src/lib/api.ts
+++ b/web/src/lib/api.ts
@@ -874,9 +874,10 @@ export const api = {
     throw new Error('Import status timed out. Check the library before retrying.')
   },
   cancelDeviceOperation: () => fetchJSON('/plaud/device-cancel', { method: 'POST', signal: AbortSignal.timeout(10000) }),
-  deleteDeviceRecording: async (sessionId: number, signal?: AbortSignal): Promise<{ deleted: boolean; alreadyGone: boolean; remaining: number }> => {
+  /** withoutCopy deletes a recording that is not in the vault; the caller must have warned that it is lost for good. */
+  deleteDeviceRecording: async (sessionId: number, signal?: AbortSignal, options: { withoutCopy?: boolean } = {}): Promise<{ deleted: boolean; alreadyGone: boolean; remaining: number }> => {
     const res = await fetchJSON<ApiEnvelope<{ deleted: boolean; alreadyGone: boolean; remaining: number }>>('/plaud/device-delete', {
-      method: 'POST', body: JSON.stringify({ sessionId, confirm: true }),
+      method: 'POST', body: JSON.stringify(options.withoutCopy ? { sessionId, confirm: true, withoutCopy: true, confirmPermanentLoss: true } : { sessionId, confirm: true }),
       signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(150000)]) : AbortSignal.timeout(150000),
     })
     return res.data
diff --git a/web/src/pages/DesktopPlaud.tsx b/web/src/pages/DesktopPlaud.tsx
