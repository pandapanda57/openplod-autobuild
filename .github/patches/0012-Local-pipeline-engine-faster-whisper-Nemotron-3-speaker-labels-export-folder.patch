diff --git a/src/transcription/local-pipeline.ts b/src/transcription/local-pipeline.ts
new file mode 100644
index 0000000..6737af0
--- /dev/null
+++ b/src/transcription/local-pipeline.ts
@@ -0,0 +1,184 @@
+import { spawn, execFile } from 'node:child_process';
+import { createHash, randomUUID } from 'node:crypto';
+import { existsSync, readdirSync, statSync, createWriteStream } from 'node:fs';
+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { constants, homedir, setPriority, tmpdir } from 'node:os';
+import { z } from 'zod';
+import { speechCapabilities } from '../ai/capabilities';
+import type { TranscriptionEngine, TranscriptionOptions, TranscriptionResult } from './types';
+import { transcriptionFailure } from './openai';
+import script from './local-pipeline.py' with { type: 'text' };
+
+/**
+ * Local pipeline engine: faster-whisper large-v3-turbo speech to text, Nemotron-3 speaker labels through the
+ * NeMo-Speech.cpp CLI, merged one speaker per Whisper segment. The Python script is built into the server and
+ * written to the work folder on use. Nothing leaves this computer: Hugging Face is forced offline, so a model
+ * that is not already cached fails with a clear message instead of downloading.
+ *
+ * Paths come from Settings (AI providers -> Local pipeline), then environment variables, then defaults:
+ *   Python       pipelinePython     | PIPELINE_PYTHON   | %LOCALAPPDATA%\plaud-asr\.venv\Scripts\python.exe
+ *   nemo-speech  pipelineNemoExe    | NEMO_SPEECH_EXE   | %LOCALAPPDATA%\nemo-speech\*vulkan*\*\bin, then *cpu*
+ *   work folder  pipelineWorkFolder | PIPELINE_WORK_DIR | %LOCALAPPDATA%\OpenPlodPipeline
+ */
+export interface PipelineSettings { python?: string; nemoExe?: string; workFolder?: string }
+
+const windows = process.platform === 'win32';
+const exeName = windows ? 'nemo-speech.exe' : 'nemo-speech';
+export const localAppData = () => process.env.LOCALAPPDATA || (windows ? join(homedir(), 'AppData', 'Local') : join(homedir(), '.local', 'share'));
+
+export function pipelinePython(settings: PipelineSettings = {}): string {
+  return settings.python || process.env.PIPELINE_PYTHON || join(localAppData(), 'plaud-asr', '.venv', windows ? 'Scripts' : 'bin', windows ? 'python.exe' : 'python');
+}
+export function pipelineWorkRoot(settings: PipelineSettings = {}): string {
+  return settings.workFolder || process.env.PIPELINE_WORK_DIR || join(localAppData(), 'OpenPlodPipeline');
+}
+
+/** nemo-speech builds in the order to try: the setting, the env var, then Vulkan (GPU) and CPU builds, newest first. */
+export function nemoCandidates(settings: PipelineSettings = {}, root = join(localAppData(), 'nemo-speech')): string[] {
+  const found: string[] = [];
+  if (settings.nemoExe) found.push(settings.nemoExe);
+  if (process.env.NEMO_SPEECH_EXE) found.push(process.env.NEMO_SPEECH_EXE);
+  const dirs = (path: string) => { try { return readdirSync(path).map(name => join(path, name)).filter(item => statSync(item).isDirectory()); } catch { return []; } };
+  const newest = (paths: string[]) => paths.sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));
+  for (const kind of ['vulkan', 'cpu']) {
+    for (const build of newest(dirs(root).filter(path => path.slice(root.length + 1).toLowerCase().includes(kind)))) {
+      const direct = join(build, 'bin', exeName);
+      if (existsSync(direct)) found.push(direct);
+      for (const inner of newest(dirs(build))) { const exe = join(inner, 'bin', exeName); if (existsSync(exe)) found.push(exe); }
+    }
+  }
+  return [...new Set(found)].filter(path => existsSync(path));
+}
+
+/** The text faster-whisper gets as its initial prompt: the context prompt, then the vocabulary as a plain list. */
+export function pipelinePrompt(options: TranscriptionOptions): string {
+  return [options.prompt?.trim(), options.vocabulary?.length ? options.vocabulary.join(', ') : ''].filter(Boolean).join('\n');
+}
+
+const segmentsSchema = z.object({
+  speakers: z.number().int().nonnegative().nullable(),
+  segments: z.array(z.object({ start: z.number().nonnegative(), end: z.number().nonnegative(), text: z.string(), speaker: z.number().int().nonnegative().nullable(),
+    words: z.array(z.object({ start: z.number(), end: z.number(), text: z.string() })) })),
+});
+const asrMetaSchema = z.object({ meta: z.object({ model: z.string(), audio_sec: z.number().nonnegative(), wall_sec: z.number() }) });
+const diarMetaSchema = z.object({ meta: z.object({ engine: z.string(), exe: z.string(), device: z.string(), speakers: z.number(), turns: z.number(), wall_sec: z.number() }) });
+
+/** Parse one stdout line of the script into a step and percent. */
+export function progressLine(line: string, state: { step: number; audioSec: number | null }): boolean {
+  let match: RegExpMatchArray | null;
+  if ((match = line.match(/^STEP (\d) /))) { state.step = Number(match[1]); return true; }
+  if ((match = line.match(/^AUDIO_SEC ([\d.]+)/))) { state.audioSec = Number(match[1]); return false; }
+  return /^\[\s*[\d.]+ min\] \d+ segments/.test(line);
+}
+export function percentDone(line: string, state: { step: number; audioSec: number | null }): number {
+  if (state.step >= 2) return state.step === 2 ? 0 : 100;
+  const match = line.match(/^\[\s*([\d.]+) min\]/);
+  if (!match || !state.audioSec) return 0;
+  return Math.max(0, Math.min(99, Math.round(Number(match[1]) * 60 / state.audioSec * 100)));
+}
+const STEP_NAMES = ['', 'speech to text', 'speaker labels', 'merge'];
+
+function killTree(pid: number | undefined) {
+  if (!pid) return;
+  if (windows) execFile('taskkill', ['/PID', String(pid), '/T', '/F'], { windowsHide: true }, () => {});
+  else try { process.kill(pid, 'SIGTERM'); } catch { /* already gone */ }
+}
+
+export class LocalPipelineEngine implements TranscriptionEngine {
+  readonly name = 'local-pipeline';
+  constructor(private readonly settings: PipelineSettings = {}) {}
+  isAvailable() { return existsSync(pipelinePython(this.settings)) && nemoCandidates(this.settings).length > 0; }
+  /** Why the engine is unavailable, for error messages. */
+  installHint(): string {
+    const python = pipelinePython(this.settings);
+    if (!existsSync(python)) return `Pipeline Python not found at ${python}. Install faster-whisper in that venv or set its path in AI settings (Local pipeline). See the README.`;
+    return 'NeMo-Speech.cpp (nemo-speech.exe) not found. Unzip it under %LOCALAPPDATA%\\nemo-speech or set its path in AI settings (Local pipeline). See the README.';
+  }
+
+  async transcribeFile(path: string, options: TranscriptionOptions = {}): Promise<TranscriptionResult> {
+    const diarize = options.diarize !== false;
+    const python = pipelinePython(this.settings), nemo = nemoCandidates(this.settings);
+    if (!existsSync(python) || (diarize && !nemo.length)) return transcriptionFailure(this.name, this.installHint());
+    const model = options.model || 'large-v3-turbo';
+    if (!(speechCapabilities['local-pipeline'].models as readonly string[]).includes(model)) return transcriptionFailure(this.name, 'Select a supported faster-whisper model.');
+    const label = (options.pipelineLabel || 'recording').replace(/[^A-Za-z0-9_.-]/g, '_').slice(0, 80);
+    const root = pipelineWorkRoot(this.settings);
+    let work = '';
+    try {
+      await mkdir(root, { recursive: true });
+      const hash = createHash('sha256').update(script).digest('hex').slice(0, 12);
+      const scriptPath = join(root, `local-pipeline-${hash}.py`);
+      if (!existsSync(scriptPath)) await writeFile(scriptPath, script, { encoding: 'utf8' });
+      work = join(root, `${new Date().toISOString().replace(/[:.]/g, '-')}_${label}_${randomUUID().slice(0, 8)}`);
+      await mkdir(work, { recursive: true });
+      const promptPath = join(work, 'prompt.txt');
+      await writeFile(promptPath, pipelinePrompt(options), { encoding: 'utf8' });
+      const args = ['-I', '-u', scriptPath, '--audio', path, '--work', work, '--model', model, '--language', options.language || 'auto',
+        '--prompt-file', promptPath, '--diarize', diarize ? '1' : '0', '--nemo', nemo.join(';'), '--recording-id', label,
+        ...(options.marksMs?.length ? ['--marks', options.marksMs.join(',')] : [])];
+      const code = await this.run(python, args, work, options);
+      if (code !== 0) {
+        const log = await readFile(join(work, 'pipeline.log'), 'utf8').catch(() => '');
+        const reason = log.split(/\r?\n/).reverse().find(line => line.startsWith('pipeline failed')) || `the pipeline exited with code ${code}`;
+        return transcriptionFailure(this.name, `Local pipeline failed: ${reason}. Log: ${join(work, 'pipeline.log')}`);
+      }
+      const own = segmentsSchema.parse(JSON.parse(await readFile(join(work, 'openplod_segments.json'), 'utf8')));
+      const asr = asrMetaSchema.parse(JSON.parse(await readFile(join(work, 'asr.json'), 'utf8')));
+      const diar = diarize ? diarMetaSchema.parse(JSON.parse(await readFile(join(work, 'diar.json'), 'utf8'))) : null;
+      const segments = own.segments.map(item => ({ start: item.start, end: item.end, text: item.text, confidence: null,
+        ...(item.speaker !== null ? { speaker: item.speaker } : {}), ...(item.words.length ? { words: item.words } : {}) }));
+      const fullText = segments.map(item => item.text).join(' ').trim();
+      return { success: true, engine: this.name, fullText, segments, wordCount: fullText.split(/\s+/).filter(Boolean).length, speakerCount: own.speakers,
+        confidence: null, duration: asr.meta.audio_sec,
+        metadata: { model, usage: null, language: options.language && options.language !== 'auto' ? options.language : null,
+          pipeline: { workDir: work, diarized: Boolean(diar), diarization: diar?.meta.engine ?? null, device: diar?.meta.device ?? null, asrWallSec: asr.meta.wall_sec } } };
+    } catch (error) {
+      options.signal?.throwIfAborted();
+      return transcriptionFailure(this.name, `Local pipeline failed: ${error instanceof Error ? error.message : String(error)}${work ? ` Work folder: ${work}` : ''}`);
+    }
+  }
+
+  /** Run the script at below-normal priority, logging to pipeline.log and reporting step and percent. */
+  private run(python: string, args: string[], work: string, options: TranscriptionOptions): Promise<number> {
+    return new Promise((resolve, reject) => {
+      const child = spawn(python, args, { cwd: work, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'],
+        env: { ...process.env, HF_HUB_OFFLINE: '1', TRANSFORMERS_OFFLINE: '1', HF_HUB_DISABLE_TELEMETRY: '1', PYTHONUTF8: '1', PYTHONIOENCODING: 'utf-8' } });
+      try { if (child.pid) setPriority(child.pid, constants.priority.PRIORITY_BELOW_NORMAL); } catch { /* the script lowers its own priority too */ }
+      const log = createWriteStream(join(work, 'pipeline.log'));
+      const state = { step: 0, audioSec: null as number | null };
+      let lastSaved = 0, lastKey = '', buffer = '', settled = false;
+      const report = (line: string) => {
+        const stepChanged = progressLine(line, state);
+        if (!state.step) return;
+        const percent = percentDone(line, state), key = `${state.step}:${percent}`, now = Date.now();
+        if (key === lastKey || (!stepChanged && now - lastSaved < 5000)) return;
+        lastKey = key; lastSaved = now;
+        options.onCheckpoint?.({ phase: `pipeline step ${state.step} of 3: ${STEP_NAMES[state.step]}`, progress: { done: percent, total: 100 } });
+      };
+      child.stdout.on('data', (chunk: Buffer) => {
+        log.write(chunk); buffer += chunk.toString('utf8');
+        const lines = buffer.split(/\r?\n/); buffer = lines.pop() ?? '';
+        for (const line of lines) report(line);
+      });
+      child.stderr.on('data', (chunk: Buffer) => log.write(chunk));
+      // Time limit: 30 minutes until the audio length is known, then 3x the audio length plus 15 minutes.
+      const started = Date.now();
+      const watchdog = setInterval(() => {
+        const limit = state.audioSec ? state.audioSec * 3000 + 15 * 60000 : 30 * 60000;
+        if (Date.now() - started > limit) { log.write(`\nOpenPlod: time limit reached after ${Math.round((Date.now() - started) / 1000)} s; stopping.\npipeline failed at time limit: stopped by OpenPlod\n`); killTree(child.pid); }
+      }, 10000);
+      const onAbort = () => killTree(child.pid);
+      options.signal?.addEventListener('abort', onAbort, { once: true });
+      const finish = (fn: () => void) => { if (settled) return; settled = true; clearInterval(watchdog); options.signal?.removeEventListener('abort', onAbort); log.end(fn); };
+      child.on('error', error => finish(() => reject(error)));
+      child.on('close', code => finish(() => { if (options.signal?.aborted) reject(options.signal.reason ?? new Error('cancelled')); else resolve(code ?? 1); }));
+    });
+  }
+
+  async transcribeBuffer(buffer: Buffer, _mimetype: string, options?: TranscriptionOptions) {
+    const directory = await mkdtemp(join(tmpdir(), 'openplod-pipeline-input-'));
+    try { const path = join(directory, 'audio'); await writeFile(path, buffer, { mode: 0o600 }); return await this.transcribeFile(path, options); }
+    finally { await rm(directory, { recursive: true, force: true }); }
+  }
+}
