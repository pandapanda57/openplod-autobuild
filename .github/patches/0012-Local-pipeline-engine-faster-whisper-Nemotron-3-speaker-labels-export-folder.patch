diff --git a/src/transcription/pipeline-export.ts b/src/transcription/pipeline-export.ts
new file mode 100644
index 0000000..7573dbe
--- /dev/null
+++ b/src/transcription/pipeline-export.ts
@@ -0,0 +1,86 @@
+import { randomUUID } from 'node:crypto';
+import { existsSync } from 'node:fs';
+import { copyFile, mkdir, rename, rm, writeFile } from 'node:fs/promises';
+import { dirname, extname, join } from 'node:path';
+import type { AiConfig } from '../ai/config';
+import { localAppData, type PipelineSettings } from './local-pipeline';
+
+/**
+ * Export folder for the local pipeline (hand-back to other tools that read the pipeline's files).
+ *
+ *   <export root>\YYYY-MM-DD_HHMM_meeting\   (local clock time the recording started; _2, _3 ... when taken)
+ *     audio.ogg asr.json diar.json diar.rttm transcript.json transcript.md timing.txt openplod.json
+ *
+ * Files are copied into a hidden temporary folder inside the export root and renamed into place at the end,
+ * so a folder carrying the final name is always complete. An existing folder is never overwritten.
+ */
+export const REQUIRED_EXPORT_FILES = ['asr.json', 'diar.json', 'diar.rttm', 'transcript.json', 'transcript.md', 'timing.txt'] as const;
+
+export function pipelineSettingsOf(config: Pick<AiConfig, 'pipelinePython' | 'pipelineNemoExe' | 'pipelineWorkFolder'>): PipelineSettings {
+  return { python: config.pipelinePython || undefined, nemoExe: config.pipelineNemoExe || undefined, workFolder: config.pipelineWorkFolder || undefined };
+}
+export function exportRoot(config: Pick<AiConfig, 'transcriptExportFolder'>): string {
+  return config.transcriptExportFolder || process.env.OPENPLOD_EXPORT_DIR || join(localAppData(), 'OpenPlodExport');
+}
+
+export interface ExportRecording { id: string; sourceRecordingId: string | null; recordedAt: string | null; uploadedAt?: string | null; durationSeconds: number | null; filePath: string }
+
+/**
+ * When the recording started. A recording read from the recorder over Bluetooth has the source id
+ * `<serial>:<session id>`, and the session id is the start time in Unix seconds. recorded_at holds the
+ * import time for those, so it is only the fallback.
+ */
+export function recordingStart(recording: Pick<ExportRecording, 'sourceRecordingId' | 'recordedAt' | 'uploadedAt'>): Date | null {
+  const session = recording.sourceRecordingId?.match(/:(\d{9,10})$/)?.[1];
+  if (session) {
+    const date = new Date(Number(session) * 1000);
+    if (date.getUTCFullYear() >= 2015 && date.getUTCFullYear() <= 2100) return date;
+  }
+  for (const value of [recording.recordedAt, recording.uploadedAt]) {
+    const date = value ? new Date(value) : null;
+    if (date && !Number.isNaN(date.getTime()) && date.getTime() > 0) return date;
+  }
+  return null;
+}
+
+const pad = (value: number) => String(value).padStart(2, '0');
+/** `YYYY-MM-DD_HHMM_meeting` in this computer's local time. */
+export function meetingFolderName(start: Date | null): string {
+  const date = start ?? new Date();
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}_${pad(date.getHours())}${pad(date.getMinutes())}_meeting`;
+}
+
+/** The decoded original next to the vault copy (recordings/originals/<id>/decoded-original.ogg), when present. */
+export function decodedOriginal(recording: Pick<ExportRecording, 'id' | 'filePath'>): string | null {
+  const path = join(dirname(recording.filePath), 'originals', recording.id, 'decoded-original.ogg');
+  return existsSync(path) ? path : null;
+}
+
+export async function writePipelineExport(input: { root: string; name: string; workDir: string; recording: ExportRecording; appVersion: string; start: Date | null }): Promise<string> {
+  const missing = REQUIRED_EXPORT_FILES.filter(file => !existsSync(join(input.workDir, file)));
+  if (missing.length) throw new Error(`the pipeline did not write ${missing.join(', ')} (speaker labels off?)`);
+  await mkdir(input.root, { recursive: true });
+  const temp = join(input.root, `.tmp-${input.name}-${randomUUID().slice(0, 8)}`);
+  await mkdir(temp);
+  try {
+    for (const file of REQUIRED_EXPORT_FILES) await copyFile(join(input.workDir, file), join(temp, file));
+    const original = decodedOriginal(input.recording);
+    const audio = original ?? input.recording.filePath;
+    await copyFile(audio, join(temp, original ? 'audio.ogg' : `audio${extname(audio) || '.m4a'}`));
+    await writeFile(join(temp, 'openplod.json'), JSON.stringify({
+      recording_id: input.recording.id, source_recording_id: input.recording.sourceRecordingId,
+      recorded_at: input.start ? input.start.toISOString() : input.recording.recordedAt, duration_seconds: input.recording.durationSeconds,
+      app_version: input.appVersion,
+    }, null, 1), 'utf8');
+    for (let index = 1; index < 1000; index++) {
+      const final = join(input.root, index === 1 ? input.name : `${input.name}_${index}`);
+      if (existsSync(final)) continue;
+      try { await rename(temp, final); return final; }
+      catch (error) { if (!existsSync(final)) throw error; /* taken in the meantime: try the next name */ }
+    }
+    throw new Error(`no free folder name for ${input.name}`);
+  } catch (error) {
+    await rm(temp, { recursive: true, force: true });
+    throw error;
+  }
+}
