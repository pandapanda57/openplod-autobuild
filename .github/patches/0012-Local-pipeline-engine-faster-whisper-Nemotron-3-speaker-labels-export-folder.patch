diff --git a/src/transcription/local-pipeline.py b/src/transcription/local-pipeline.py
new file mode 100644
index 0000000..185c7bd
--- /dev/null
+++ b/src/transcription/local-pipeline.py
@@ -0,0 +1,256 @@
+"""OpenPlod local pipeline: faster-whisper speech to text + Nemotron-3 speaker labels (NeMo-Speech.cpp CLI).
+
+Started by src/transcription/local-pipeline.ts with the pipeline Python (a venv holding faster-whisper and
+soundfile). Everything runs on this computer; Hugging Face is forced offline by the caller, so a model that is
+not cached fails instead of downloading.
+
+  python -I -u local-pipeline.py --audio IN --work DIR [--model large-v3-turbo] [--language en|auto]
+         [--prompt-file FILE] [--diarize 1|0] [--nemo EXE;EXE] [--recording-id NAME] [--marks ms,ms] [--ffmpeg EXE]
+
+Writes into DIR: audio16k.wav, asr.json, diar.rttm, diar.json, transcript.json, transcript.md, timing.txt,
+openplod_segments.json (OpenPlod's own read-back, with word timings), diarize.log.
+stdout lines OpenPlod reads: "STEP <n> <name>", "AUDIO_SEC <seconds>", "[  12.3 min] 140 segments".
+"""
+import argparse, json, os, subprocess, sys, time
+from datetime import datetime
+
+BELOW_NORMAL_PRIORITY_CLASS = 0x4000
+ENGINE_DIAR = "nemotron-3-diarization/v3-offline"
+JOIN_GAP_SEC = 2.0
+
+
+def below_normal():
+    """Below-normal CPU priority; ffmpeg and nemo-speech started from here inherit it."""
+    if os.name == "nt":
+        import ctypes
+        k = ctypes.windll.kernel32
+        k.SetPriorityClass(k.GetCurrentProcess(), BELOW_NORMAL_PRIORITY_CLASS)
+    else:
+        try:
+            os.nice(10)
+        except OSError:
+            pass
+
+
+def now_iso():
+    return datetime.now().astimezone().isoformat(timespec="seconds")
+
+
+def hms(sec):
+    sec = int(sec)
+    return f"{sec // 3600}:{sec % 3600 // 60:02d}:{sec % 60:02d}"
+
+
+def say(line):
+    print(line, flush=True)
+
+
+class Timing:
+    def __init__(self, path):
+        self.path = path
+        with open(path, "w", encoding="utf-8") as f:
+            f.write(f"start {now_iso()}\n")
+
+    def add(self, line):
+        with open(self.path, "a", encoding="utf-8") as f:
+            f.write(line + "\n")
+
+
+def decode(ffmpeg, audio, wav):
+    subprocess.run([ffmpeg, "-v", "error", "-y", "-i", audio, "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", wav],
+                   check=True, stdin=subprocess.DEVNULL)
+
+
+def asr(wav, model_name, language, prompt):
+    import soundfile as sf
+    from faster_whisper import WhisperModel
+    # float32 samples, not a path: faster-whisper 1.2.1's own decoder breaks on PyAV 19.
+    samples, rate = sf.read(wav, dtype="float32")
+    if rate != 16000:
+        raise RuntimeError(f"expected 16 kHz audio, got {rate}")
+    audio_sec = len(samples) / 16000.0
+    say(f"AUDIO_SEC {audio_sec:.3f}")
+    t0 = time.time()
+    try:
+        model = WhisperModel(model_name, device="cpu", compute_type="int8", cpu_threads=os.cpu_count() or 4)
+    except Exception as e:  # model missing from the cache while offline, or a broken install
+        raise RuntimeError(f"could not load faster-whisper model {model_name!r} from the local cache "
+                           f"(downloads are off): {e}") from e
+    segs, _info = model.transcribe(samples, language=language, vad_filter=True, word_timestamps=True, beam_size=5,
+                                   initial_prompt=prompt or None)
+    out = []
+    for s in segs:
+        out.append({"start": round(s.start, 3), "end": round(s.end, 3), "text": s.text.strip(),
+                    "words": [{"start": round(w.start, 3), "end": round(w.end, 3), "word": w.word} for w in (s.words or [])]})
+        say(f"[{s.end / 60:6.1f} min] {len(out)} segments")
+    meta = {"model": model_name, "audio_sec": round(audio_sec, 3), "wall_sec": round(time.time() - t0, 1)}
+    return {"meta": meta, "segments": out}
+
+
+def build_device(exe):
+    low = exe.lower()
+    return "vulkan" if "vulkan" in low else "cpu" if "cpu" in low else "auto"
+
+
+def read_rttm(path):
+    turns = []
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            p = line.split()
+            if len(p) >= 8 and p[0] == "SPEAKER":
+                start, dur = float(p[3]), float(p[4])
+                turns.append({"start": round(start, 3), "end": round(start + dur, 3), "speaker": p[7]})
+    turns.sort(key=lambda t: t["start"])
+    return turns
+
+
+def diarize(wav, work, exes, recording_id):
+    """Try each nemo-speech build in order (GPU first); the first that writes an RTTM wins."""
+    rttm = os.path.join(work, "diar.rttm")
+    log_path = os.path.join(work, "diarize.log")
+    errors = []
+    for exe in exes:
+        t0 = time.time()
+        with open(log_path, "a", encoding="utf-8") as log:
+            log.write(f"== {now_iso()} {exe}\n")
+            log.flush()
+            rc = subprocess.run([exe, "diarize", wav, "--device", "auto", "--preset", "v3-offline", "--format", "rttm",
+                                 "--recording-id", recording_id, "--output", rttm, "--force"],
+                                stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode
+        if rc == 0 and os.path.exists(rttm):
+            turns = read_rttm(rttm)
+            meta = {"engine": ENGINE_DIAR, "exe": exe, "device": build_device(exe),
+                    "speakers": len({t["speaker"] for t in turns}), "turns": len(turns),
+                    "wall_sec": round(time.time() - t0, 1)}
+            return {"meta": meta, "turns": turns}
+        errors.append(f"{exe} exit {rc}")
+        say(f"diarize: {exe} failed (exit {rc}), trying the next build")
+    raise RuntimeError("every nemo-speech build failed: " + "; ".join(errors or ["none found"]))
+
+
+def speaker_for(seg, turns):
+    """Most overlap; else the turn covering the midpoint; else the nearest turn. Never word by word."""
+    if not turns:
+        return None
+    best, best_ov = None, 0.0
+    for t in turns:
+        ov = min(seg["end"], t["end"]) - max(seg["start"], t["start"])
+        if ov > best_ov:
+            best, best_ov = t["speaker"], ov
+    if best is not None:
+        return best
+    mid = (seg["start"] + seg["end"]) / 2
+    for t in turns:
+        if t["start"] <= mid <= t["end"]:
+            return t["speaker"]
+    return min(turns, key=lambda t: min(abs(mid - t["start"]), abs(mid - t["end"])))["speaker"]
+
+
+def merge(asr_out, diar_out, marks_sec, model_name):
+    turns = diar_out["turns"] if diar_out else []
+    utts = []  # with words, for OpenPlod; transcript.json drops them
+    for seg in asr_out["segments"]:
+        if not seg["text"]:
+            continue
+        spk = speaker_for(seg, turns)
+        last = utts[-1] if utts else None
+        if last and last["raw"] == spk and seg["start"] - last["end"] < JOIN_GAP_SEC:
+            last["end"] = seg["end"]
+            last["text"] = (last["text"] + " " + seg["text"]).strip()
+            last["words"].extend(seg["words"])
+        else:
+            utts.append({"raw": spk, "start": seg["start"], "end": seg["end"], "text": seg["text"], "words": list(seg["words"])})
+    names = {}
+    for u in utts:
+        if u["raw"] not in names:
+            names[u["raw"]] = "Speaker " + chr(ord("A") + len(names)) if len(names) < 26 else f"Speaker {len(names) + 1}"
+        u["speaker"] = names[u["raw"]]
+        u["index"] = list(names).index(u["raw"])
+    transcript = {"meta": asr_out["meta"], "marks_sec": marks_sec,
+                  "utterances": [{"speaker": u["speaker"], "start": u["start"], "end": u["end"], "text": u["text"]} for u in utts]}
+    diar_part = f" + {ENGINE_DIAR} speaker labels" if diar_out else " (no speaker labels)"
+    lines = ["# Transcript", "", f"Engine: faster-whisper {model_name}{diar_part} (local).", ""]
+    pending = sorted(marks_sec)
+    for u in utts:
+        while pending and pending[0] < u["end"]:
+            lines += [f"> **HIGHLIGHT pressed at {hms(pending.pop(0))}**", ""]
+        lines += [f"**[{hms(u['start'])}] {u['speaker']}:** {u['text']}", ""]
+    for m in pending:
+        lines += [f"> **HIGHLIGHT pressed at {hms(m)}**", ""]
+    segments = [{"start": u["start"], "end": u["end"], "text": u["text"], "speaker": u["index"] if diar_out else None,
+                 "words": [{"start": w["start"], "end": w["end"], "text": w["word"].strip()} for w in u["words"] if w["word"].strip()]}
+                for u in utts]
+    return transcript, "\n".join(lines).rstrip() + "\n", {"speakers": len(names) if diar_out else None, "segments": segments}
+
+
+def dump(path, obj):
+    tmp = path + ".part"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(obj, f, ensure_ascii=False, indent=1)
+    os.replace(tmp, path)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--audio", required=True)
+    ap.add_argument("--work", required=True)
+    ap.add_argument("--model", default="large-v3-turbo")
+    ap.add_argument("--language", default="en")
+    ap.add_argument("--prompt-file", default="")
+    ap.add_argument("--diarize", default="1")
+    ap.add_argument("--nemo", default="")
+    ap.add_argument("--recording-id", default="")
+    ap.add_argument("--marks", default="")
+    ap.add_argument("--ffmpeg", default="ffmpeg")
+    a = ap.parse_args()
+    sys.stdout.reconfigure(encoding="utf-8")
+    below_normal()
+    work = os.path.abspath(a.work)
+    os.makedirs(work, exist_ok=True)
+    timing = Timing(os.path.join(work, "timing.txt"))
+    prompt = open(a.prompt_file, encoding="utf-8").read().strip() if a.prompt_file else ""
+    language = None if a.language in ("", "auto") else a.language
+    marks = sorted(int(x) / 1000.0 for x in a.marks.split(",") if x.strip())
+    exes = [x for x in a.nemo.split(";") if x.strip()]
+    want_diar = a.diarize == "1"
+    wav = os.path.join(work, "audio16k.wav")
+    step = "decode"
+    try:
+        say("STEP 1 asr")
+        decode(a.ffmpeg, a.audio, wav)
+        step = "asr"
+        t0 = time.time()
+        asr_out = asr(wav, a.model, language, prompt)
+        dump(os.path.join(work, "asr.json"), asr_out)
+        timing.add(f"asr wall_sec {int(time.time() - t0)}")
+        diar_out = None
+        if want_diar:
+            step = "diarize"
+            say("STEP 2 diarize")
+            t0 = time.time()
+            diar_out = diarize(wav, work, exes, a.recording_id or os.path.basename(work))
+            dump(os.path.join(work, "diar.json"), diar_out)
+            timing.add(f"diarize wall_sec {int(time.time() - t0)}")
+        step = "merge"
+        say("STEP 3 merge")
+        t0 = time.time()
+        transcript, md, own = merge(asr_out, diar_out, marks, a.model)
+        dump(os.path.join(work, "transcript.json"), transcript)
+        with open(os.path.join(work, "transcript.md"), "w", encoding="utf-8") as f:
+            f.write(md)
+        dump(os.path.join(work, "openplod_segments.json"), own)
+        timing.add(f"merge wall_sec {int(time.time() - t0)}")
+        timing.add(f"end {now_iso()}")
+    except BaseException as e:
+        timing.add(f"FAILED {step}")
+        print(f"pipeline failed at {step}: {e}", file=sys.stderr, flush=True)
+        sys.exit(2)
+    finally:
+        try:
+            os.remove(wav)
+        except OSError:
+            pass
+
+
+if __name__ == "__main__":
+    main()
