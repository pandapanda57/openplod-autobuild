+import { afterEach, expect, test } from 'bun:test';
+import { existsSync, mkdtempSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { REQUIRED_EXPORT_FILES, meetingFolderName, recordingStart, writePipelineExport } from './pipeline-export';
+
+let dirs: string[] = [];
+afterEach(() => { for (const dir of dirs) rmSync(dir, { recursive: true, force: true }); dirs = []; });
+const temp = () => { const dir = mkdtempSync(join(tmpdir(), 'openplod-export-test-')); dirs.push(dir); return dir; };
+
+test('the start time comes from the Bluetooth session id, not the import time', () => {
+  const start = recordingStart({ sourceRecordingId: 'SERIAL:1794594645', recordedAt: '2026-11-13T19:57:36.729Z' });
+  expect(start?.toISOString()).toBe('2026-11-13T18:30:45.000Z');
+  expect(recordingStart({ sourceRecordingId: null, recordedAt: '2026-11-13T19:57:36.729Z' })?.toISOString()).toBe('2026-11-13T19:57:36.729Z');
+  expect(recordingStart({ sourceRecordingId: 'upload-abc', recordedAt: null, uploadedAt: null })).toBeNull();
+});
+
+test('folder names use local clock time', () => {
+  expect(meetingFolderName(new Date(2026, 10, 13, 10, 30, 45))).toBe('2026-11-13_1030_meeting');
+  expect(meetingFolderName(new Date(2026, 0, 2, 3, 4))).toBe('2026-01-02_0304_meeting');
+});
+
+function fixture() {
+  const vault = temp(), work = temp(), id = crypto.randomUUID();
+  for (const file of REQUIRED_EXPORT_FILES) writeFileSync(join(work, file), file);
+  const originals = join(vault, 'originals', id); mkdirSync(originals, { recursive: true });
+  writeFileSync(join(originals, 'decoded-original.ogg'), 'ogg');
+  writeFileSync(join(vault, `${id}.m4a`), 'm4a');
+  return { work, recording: { id, sourceRecordingId: 'S:1794594645', recordedAt: null, durationSeconds: 81, filePath: join(vault, `${id}.m4a`) } };
+}
+
+test('an export is complete when it appears, carries audio.ogg and openplod.json, and never overwrites', async () => {
+  const root = temp(), { work, recording } = fixture(), start = new Date(1794594645000);
+  const first = await writePipelineExport({ root, name: '2026-11-13_1030_meeting', workDir: work, recording, appVersion: '1.1.6', start });
+  expect(first).toBe(join(root, '2026-11-13_1030_meeting'));
+  expect(readdirSync(first).sort()).toEqual([...REQUIRED_EXPORT_FILES, 'audio.ogg', 'openplod.json'].sort());
+  expect(readFileSync(join(first, 'audio.ogg'), 'utf8')).toBe('ogg');
+  expect(JSON.parse(readFileSync(join(first, 'openplod.json'), 'utf8'))).toEqual({ recording_id: recording.id, source_recording_id: 'S:1794594645', recorded_at: '2026-11-13T18:30:45.000Z', duration_seconds: 81, app_version: '1.1.6' });
+  const second = await writePipelineExport({ root, name: '2026-11-13_1030_meeting', workDir: work, recording, appVersion: '1.1.6', start });
+  expect(second).toBe(join(root, '2026-11-13_1030_meeting_2'));
+  expect(readdirSync(root).filter(name => name.startsWith('.tmp-'))).toEqual([]);
+});
+
