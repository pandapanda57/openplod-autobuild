+import { speechCapabilities } from '../ai/capabilities';
+import { aiConfigFromSettings, aiConfigSchema, isLocalProvider } from '../ai/config';
+import { estimateSpeechUsd } from '../ai/pricing';
+
+const exe = process.platform === 'win32' ? 'nemo-speech.exe' : 'nemo-speech';
+let dirs: string[] = [];
+afterEach(() => { for (const dir of dirs) rmSync(dir, { recursive: true, force: true }); dirs = []; });
+const temp = () => { const dir = mkdtempSync(join(tmpdir(), 'openplod-lp-test-')); dirs.push(dir); return dir; };
+const build = (root: string, folder: string) => { const bin = join(root, folder, 'inner', 'bin'); mkdirSync(bin, { recursive: true }); writeFileSync(join(bin, exe), ''); return join(bin, exe); };
+
+test('the local pipeline is the default engine, English, with speaker labels', () => {
+  const config = aiConfigFromSettings({});
+  expect(config.transcriptionEngine).toBe('local-pipeline');
+  expect(config.transcriptionLanguage).toBe('en');
+  expect(config.transcriptionDiarize).toBe(true);
+  expect(config.transcriptExport).toBe(true);
+  expect(speechCapabilities['local-pipeline'].models[0]).toBe('large-v3-turbo');
+});
+
+test('a config naming another engine does not inherit the pipeline defaults', () => {
+  const config = aiConfigSchema.parse({ transcriptionEngine: 'mistral' });
+  expect(config).toMatchObject({ transcriptionLanguage: 'auto', transcriptionDiarize: false });
+  expect(aiConfigFromSettings({ transcriptionEngine: 'whisper' })).toMatchObject({ transcriptionEngine: 'whisper', transcriptionDiarize: false });
+});
+
+test('the local pipeline counts as local: allowed in local-only mode and free', () => {
+  expect(isLocalProvider({ customBaseUrl: '' }, 'local-pipeline')).toBe(true);
+  expect(speechCapabilities['local-pipeline'].local).toBe(true);
+  expect(estimateSpeechUsd('local-pipeline', 'large-v3-turbo', 3600)).toBe(0);
+});
+
+test('nemo-speech builds: setting first, then Vulkan before CPU, newest version first', () => {
+  const root = temp();
+  const cpu = build(root, '0.3.0-cpu'), vulkanOld = build(root, '0.2.0-vulkan'), vulkanNew = build(root, '0.3.0-vulkan');
+  const chosen = join(temp(), exe); writeFileSync(chosen, '');
+  const saved = process.env.NEMO_SPEECH_EXE; delete process.env.NEMO_SPEECH_EXE;
+  try {
+    expect(nemoCandidates({}, root)).toEqual([vulkanNew, vulkanOld, cpu]);
+    expect(nemoCandidates({ nemoExe: chosen }, root)).toEqual([chosen, vulkanNew, vulkanOld, cpu]);
+    expect(nemoCandidates({ nemoExe: join(root, 'missing.exe') }, root)).toEqual([vulkanNew, vulkanOld, cpu]);
+  } finally { if (saved !== undefined) process.env.NEMO_SPEECH_EXE = saved; }
+});
+
+test('progress: step lines, audio length, and percent from the segment end time', () => {
+  const state = { step: 0, audioSec: null as number | null };
+  expect(progressLine('STEP 1 asr', state)).toBe(true);
+  expect(progressLine('AUDIO_SEC 600.000', state)).toBe(false);
+  expect(state).toEqual({ step: 1, audioSec: 600 });
+  expect(progressLine('[   5.0 min] 140 segments', state)).toBe(true);
+  expect(percentDone('[   5.0 min] 140 segments', state)).toBe(50);
+  expect(percentDone('[  12.0 min] 300 segments', state)).toBe(99);
+  progressLine('STEP 2 diarize', state); expect(percentDone('', state)).toBe(0);
+  progressLine('STEP 3 merge', state); expect(percentDone('', state)).toBe(100);
+});
+
+test('the initial prompt is the context prompt, then the vocabulary as a plain list', () => {
+  expect(pipelinePrompt({ prompt: ' Weekly call. ', vocabulary: ['Acme', 'Globex'] })).toBe('Weekly call.\nAcme, Globex');
+  expect(pipelinePrompt({})).toBe('');
+});
+
+test('a missing pipeline Python is reported with an install hint, nothing is run', async () => {
+  const engine = new LocalPipelineEngine({ python: join(temp(), 'no-python.exe'), nemoExe: join(temp(), 'none.exe') });
+  expect(engine.isAvailable()).toBe(false);
+  const result = await engine.transcribeFile(join(temp(), 'audio.ogg'));
