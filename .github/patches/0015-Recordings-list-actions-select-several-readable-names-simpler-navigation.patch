new file mode 100644
index 0000000..2eb56e2
--- /dev/null
+++ b/web/src/lib/text-ai.ts
@@ -0,0 +1,46 @@
+/**
+ * Whether summaries, documents and chat can run with the current AI settings, and if not, why.
+ * Used to explain greyed-out AI buttons instead of leaving them silently disabled.
+ */
+import { useEffect, useState } from 'react'
+import { aiSettingsApi, type AiSettings } from '@/lib/ai-settings'
+import { t } from '@/i18n'
+
+export type TextTask = 'analysis' | 'document' | 'chat'
+
+const PROVIDER_NAMES: Record<string, string> = { mistral: 'Mistral', openai: 'OpenAI', anthropic: 'Anthropic', gemini: 'Gemini', ollama: 'Ollama', custom: 'custom endpoint' }
+
+let cached: { at: number; value: Promise<AiSettings | null> } | null = null
+const CACHE_MS = 30000
+
+function loadSettings(): Promise<AiSettings | null> {
+  if (!cached || Date.now() - cached.at > CACHE_MS) cached = { at: Date.now(), value: aiSettingsApi.get().catch(() => null) }
+  return cached.value
+}
+
+/** Forget the cached settings (after they were saved). */
+export function invalidateTextAi() { cached = null }
+
+/** The reason a text AI task cannot run, or null when it is set up. */
+export function textAiProblem(settings: AiSettings | null, task: TextTask): string | null {
+  if (!settings) return null
+  const provider = settings[`${task}Provider`]
+  const model = settings[`${task}Model`]
+  if (provider === 'ollama' && !model) return t('Choose an Ollama model in Settings, AI providers.')
+  if (provider === 'custom' && !settings.customBaseUrl) return t('Enter the custom endpoint address in Settings, AI providers.')
+  if (provider === 'custom' && !model) return t('Enter the model name for the custom endpoint in Settings, AI providers.')
+  if (settings.textCapabilities?.[provider]?.requiresKey && !settings.credentials?.[`${provider}ApiKey`])
+    return t('Add a {provider} API key in Settings, AI providers, or choose a local model there.', { provider: PROVIDER_NAMES[provider] ?? provider })
+  return null
+}
+
+/** The AI settings for readiness checks; null while loading or when they cannot be read. */
+export function useTextAiSettings(): AiSettings | null {
+  const [settings, setSettings] = useState<AiSettings | null>(null)
+  useEffect(() => {
+    let live = true
+    void loadSettings().then(value => { if (live) setSettings(value) })
+    return () => { live = false }
+  }, [])
+  return settings
+}
