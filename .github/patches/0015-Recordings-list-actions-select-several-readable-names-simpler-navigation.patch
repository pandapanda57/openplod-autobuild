+/** True when the transcript's segments carry speaker labels (the preview then shows speaker turns). */
+const hasSpeakers = (segments?: TranscriptSegment[]) => Boolean(segments?.length && segments.some(segment => segment.speakerId !== null))
+
+/** The transcript as speaker turns: consecutive segments from one speaker joined, with the start time. */
+function SpeakerTurns({ segments }: { segments: TranscriptSegment[] }) {
+  const turns: { speaker: string; start: number; text: string }[] = []
+  for (const segment of segments) {
+    const last = turns[turns.length - 1], text = segment.text.trim()
+    if (last && last.speaker === segment.speaker) last.text += ` ${text}`
+    else turns.push({ speaker: segment.speaker, start: segment.startTime, text })
+  }
+  return <>{turns.map((turn, index) => <p key={index}><strong>{turn.speaker}</strong> <span className="text-xs text-muted-foreground">{formatDuration(turn.start)}</span><br />{turn.text}</p>)}</>
