+test('pipeline Python: the setting, then the profile folder, then AppData; the first existing one wins', () => {
+  const home = temp(), local = temp(), python = (root: string) => join(root, 'plaud-asr', '.venv', process.platform === 'win32' ? 'Scripts' : 'bin', process.platform === 'win32' ? 'python.exe' : 'python');
+  const make = (path: string) => { mkdirSync(join(path, '..'), { recursive: true }); writeFileSync(path, ''); };
+  const saved = process.env.PIPELINE_PYTHON; delete process.env.PIPELINE_PYTHON;
+  try {
+    const candidates = pythonCandidates(home, local);
+    expect(candidates).toEqual([python(home), python(local)]);
+    expect(pipelinePython({}, candidates)).toBe(python(home)); // nothing exists: report the first place to put it
+    make(python(local)); expect(pipelinePython({}, candidates)).toBe(python(local));
+    make(python(home)); expect(pipelinePython({}, candidates)).toBe(python(home));
+    expect(pipelinePython({ python: 'C:\\chosen\\python.exe' }, candidates)).toBe('C:\\chosen\\python.exe');
+  } finally { if (saved !== undefined) process.env.PIPELINE_PYTHON = saved; }
+});
+
+test('the install hint explains venvs hidden inside a Store app', () => {
+  expect(new LocalPipelineEngine({ python: join(temp(), 'missing.exe') }).installHint()).toContain('Claude desktop app');
+});
