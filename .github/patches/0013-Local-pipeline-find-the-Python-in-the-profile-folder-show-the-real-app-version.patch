+const venvPython = (root: string) => join(root, 'plaud-asr', '.venv', windows ? 'Scripts' : 'bin', windows ? 'python.exe' : 'python');
+/**
+ * Where to look for the pipeline Python when the setting and PIPELINE_PYTHON are empty:
+ * %USERPROFILE%\plaud-asr\.venv first, then %LOCALAPPDATA%\plaud-asr\.venv.
+ * The profile folder comes first because a venv created from a packaged (MSIX) app such as the Claude desktop
+ * app under AppData is redirected into that app's private folder and is invisible to OpenPlod.
+ */
+export function pythonCandidates(home = homedir(), local = localAppData()): string[] {
+  return [...new Set([venvPython(home), venvPython(local)])];
+}
+export function pipelinePython(settings: PipelineSettings = {}, candidates = pythonCandidates()): string {
+  if (settings.python) return settings.python;
+  if (process.env.PIPELINE_PYTHON) return process.env.PIPELINE_PYTHON;
+  return candidates.find(path => existsSync(path)) ?? candidates[0];
 }
 export function pipelineWorkRoot(settings: PipelineSettings = {}): string {
   return settings.workFolder || process.env.PIPELINE_WORK_DIR || join(localAppData(), 'OpenPlodPipeline');
