+.settings-section > .rounded-lg > div { padding-left: 0; padding-right: 0; }
+.settings-section > .rounded-lg > div:first-child { padding-top: 24px; }
+@media (max-width: 767px) {
+  .settings-columns { grid-template-columns: minmax(0, 1fr); gap: 16px; }
