diff --git a/src-tauri/src/tray.rs b/src-tauri/src/tray.rs
new file mode 100644
index 0000000..ffe3ca8
--- /dev/null
+++ b/src-tauri/src/tray.rs
@@ -0,0 +1,83 @@
+//! System tray icon. Closing or minimizing the window hides OpenPlod to the tray so the local
+//! service keeps running (automatic imports, update checks); "Quit OpenPlod" in the tray menu
+//! exits the app and, through `RunEvent::Exit`, stops the service.
+use tauri::menu::{Menu, MenuItem, PredefinedMenuItem};
+use tauri::tray::{MouseButton, MouseButtonState, TrayIconBuilder, TrayIconEvent};
+use tauri::{AppHandle, Emitter, Manager, Window, WindowEvent};
+
+const MAIN: &str = "main";
+
+/// Pages the tray menu can open. The web app listens for `tray-navigate` and routes there.
+const PAGES: [(&str, &str, &str); 3] = [
+  ("tray-record", "New recording", "/record"),
+  ("tray-device", "Plaud Device", "/devices"),
+  ("tray-settings", "Settings", "/settings"),
+];
+
+pub fn show_main_window(app: &AppHandle) {
+  if let Some(window) = app.get_webview_window(MAIN) {
+    let _ = window.unminimize();
+    let _ = window.show();
+    let _ = window.set_focus();
+  }
+}
+
+pub fn create(app: &tauri::App) -> tauri::Result<()> {
+  let open = MenuItem::with_id(app, "tray-open", "Open OpenPlod", true, None::<&str>)?;
+  let pages = PAGES
+    .iter()
+    .map(|(id, label, _)| MenuItem::with_id(app, *id, *label, true, None::<&str>))
+    .collect::<tauri::Result<Vec<_>>>()?;
+  let separator = PredefinedMenuItem::separator(app)?;
+  let quit = MenuItem::with_id(app, "tray-quit", "Quit OpenPlod", true, None::<&str>)?;
+  let mut items: Vec<&dyn tauri::menu::IsMenuItem<tauri::Wry>> = vec![&open];
+  items.extend(pages.iter().map(|item| item as &dyn tauri::menu::IsMenuItem<tauri::Wry>));
+  items.push(&separator);
+  items.push(&quit);
+  let menu = Menu::with_items(app, &items)?;
+
+  let mut tray = TrayIconBuilder::with_id("openplod")
+    .tooltip("OpenPlod")
+    .menu(&menu)
+    .show_menu_on_left_click(false)
+    .on_menu_event(|app, event| {
+      let id = event.id().as_ref();
+      if id == "tray-quit" {
+        app.exit(0);
+      } else if id == "tray-open" {
+        show_main_window(app);
+      } else if let Some((_, _, path)) = PAGES.iter().find(|(page, _, _)| *page == id) {
+        show_main_window(app);
+        let _ = app.emit_to(MAIN, "tray-navigate", *path);
+      }
+    })
+    .on_tray_icon_event(|tray, event| {
+      if let TrayIconEvent::Click { button: MouseButton::Left, button_state: MouseButtonState::Up, .. } = event {
+        show_main_window(tray.app_handle());
+      }
+    });
+  if let Some(icon) = app.default_window_icon() {
+    tray = tray.icon(icon.clone());
+  }
+  tray.build(app)?;
+  Ok(())
+}
+
+/// Close (X) and minimize hide the main window to the tray instead of quitting or minimizing.
+pub fn on_window_event(window: &Window, event: &WindowEvent) {
+  if window.label() != MAIN {
+    return;
+  }
+  match event {
+    WindowEvent::CloseRequested { api, .. } => {
+      api.prevent_close();
+      let _ = window.hide();
+    }
+    WindowEvent::Resized(_) => {
+      if window.is_minimized().unwrap_or(false) {
+        let _ = window.hide();
+      }
+    }
+    _ => {}
+  }
+}
