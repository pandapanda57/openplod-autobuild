diff --git a/web/src/components/TrayNavigation.tsx b/web/src/components/TrayNavigation.tsx
new file mode 100644
index 0000000..1632146
--- /dev/null
+++ b/web/src/components/TrayNavigation.tsx
@@ -0,0 +1,21 @@
+import { useEffect } from 'react'
+import { useNavigate } from 'react-router-dom'
+import { getRuntime } from '@/lib/runtime'
+
+/** Opens the page chosen in the desktop tray menu (New recording, Plaud Device, Settings). */
+const ALLOWED = new Set(['/record', '/devices', '/settings'])
+
+export function TrayNavigation() {
+  const navigate = useNavigate()
+  const desktop = getRuntime().mode === 'desktop'
+  useEffect(() => {
+    if (!desktop) return
+    let stop: (() => void) | undefined
+    let disposed = false
+    void import('@tauri-apps/api/event').then(({ listen }) => listen<string>('tray-navigate', event => {
+      if (ALLOWED.has(event.payload)) navigate(event.payload)
+    })).then(unlisten => { if (disposed) unlisten(); else stop = unlisten }).catch(() => undefined)
+    return () => { disposed = true; stop?.() }
+  }, [desktop, navigate])
+  return null
+}
