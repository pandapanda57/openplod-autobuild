+export type LmStudioModel = { id: string; maxContext: number | null; loadedContext: number | null; loaded: boolean };
+/** LM Studio's REST API sits beside its OpenAI-compatible `/v1` path. */
+const lmstudioRest = (baseUrl: string) => baseUrl.replace(/\/v1$/, '');
+export const LMSTUDIO_OFF = 'LM Studio is not answering. Open LM Studio and turn on its local server (Developer, Local Server: Status Running). OpenPlod never starts it.';
+
+/** The chat models LM Studio offers (downloaded or loaded), without embedding models. */
+export async function lmstudioModels(baseUrl: string, fetcher: Fetcher = fetch): Promise<LmStudioModel[]> {
+  let response: Response;
+  try { response = await fetcher(`${lmstudioRest(baseUrl)}/api/v0/models`, { redirect: 'error', signal: AbortSignal.timeout(4000) }); }
+  catch { throw new Error(LMSTUDIO_OFF); }
+  if (response.ok) {
+    const payload = z.object({ data: z.array(z.object({ id: z.string(), type: z.string().optional(), state: z.string().optional(), max_context_length: z.number().nullable().optional(), loaded_context_length: z.number().nullable().optional() }).passthrough()) }).parse(await response.json());
+    return payload.data.filter(item => item.type !== 'embeddings' && !/embed/i.test(item.id))
+      .map(item => ({ id: item.id, maxContext: item.max_context_length ?? null, loadedContext: item.loaded_context_length ?? null, loaded: item.state === 'loaded' }));
+  }
+  // Older LM Studio builds only have the OpenAI-compatible list.
+  try { response = await fetcher(`${baseUrl}/models`, { redirect: 'error', signal: AbortSignal.timeout(4000) }); }
+  catch { throw new Error(LMSTUDIO_OFF); }
+  if (!response.ok) throw new Error(LMSTUDIO_OFF);
+  const payload = z.object({ data: z.array(z.object({ id: z.string() }).passthrough()) }).parse(await response.json());
+  return payload.data.filter(item => !/embed/i.test(item.id)).map(item => ({ id: item.id, maxContext: null, loadedContext: null, loaded: false }));
+}
