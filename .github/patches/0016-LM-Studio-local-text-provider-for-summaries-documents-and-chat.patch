diff --git a/src/ai/lmstudio.test.ts b/src/ai/lmstudio.test.ts
new file mode 100644
index 0000000..b66ddbd
--- /dev/null
+++ b/src/ai/lmstudio.test.ts
@@ -0,0 +1,67 @@
+import { expect, test } from 'bun:test';
+import { aiConfigSchema, DEFAULT_LMSTUDIO_URL, isLocalProvider } from './config';
+import { ContextLimitError, completeText, lmstudioModels } from './text';
+import { estimateTextUsd } from './pricing';
+
+const base = 'http://127.0.0.1:1234/v1';
+type Model = { id: string; type?: string; state?: string; max_context_length?: number | null; loaded_context_length?: number | null };
+/** A fake LM Studio: its REST model list and an OpenAI-compatible chat endpoint. */
+function fakeLmStudio(models: Model[], answer = 'Summary.', after?: Model[]) {
+  const calls: string[] = [];
+  let chats = 0;
+  const fetcher = async (url: string, init: RequestInit) => {
+    calls.push(`${init.method ?? 'GET'} ${url}`);
+    if (url === 'http://127.0.0.1:1234/api/v0/models') return Response.json({ data: chats && after ? after : models });
+    if (url === `${base}/chat/completions`) { chats++; return Response.json({ model: JSON.parse(String(init.body)).model, choices: [{ finish_reason: 'stop', message: { content: answer } }], usage: { prompt_tokens: 10, completion_tokens: 3 } }); }
+    return new Response('not found', { status: 404 });
+  };
+  return { fetcher, calls };
+}
+
+test('LM Studio is local by default, needs no key, costs nothing, and its address is filled in', () => {
+  const config = aiConfigSchema.parse({});
+  expect(config.lmstudioBaseUrl).toBe(DEFAULT_LMSTUDIO_URL);
+  expect(isLocalProvider(config, 'lmstudio')).toBe(true);
+  expect(isLocalProvider({ customBaseUrl: '', lmstudioBaseUrl: 'https://example.com/v1' }, 'lmstudio')).toBe(false);
+  expect(estimateTextUsd('lmstudio', 'qwen/qwen3.8-27b', { prompt_tokens: 1000, completion_tokens: 100 })).toBe(0);
+  expect(() => aiConfigSchema.parse({ lmstudioBaseUrl: 'http://example.com/v1' })).toThrow();
+});
+
+test('the model list leaves out embedding models and keeps context sizes', async () => {
+  const { fetcher } = fakeLmStudio([
+    { id: 'google/gemma-4-e4b', type: 'vlm', state: 'not-loaded', max_context_length: 131072 },
+    { id: 'text-embedding-nomic-embed-text-v1.5', type: 'embeddings', state: 'not-loaded', max_context_length: 2048 },
+  ]);
+  expect(await lmstudioModels(base, fetcher)).toEqual([{ id: 'google/gemma-4-e4b', maxContext: 131072, loadedContext: null, loaded: false }]);
+});
+
+test('LM Studio not running gives a clear message and sends nothing', async () => {
+  const fetcher = async () => { throw new TypeError('connection refused'); };
+  await expect(completeText({ provider: 'lmstudio', model: 'google/gemma-4-e4b', baseUrl: base }, [{ role: 'user', content: 'x' }], {}, fetcher)).rejects.toThrow('turn on its local server');
+});
+
+test('an answer is returned without the reasoning block', async () => {
+  const { fetcher, calls } = fakeLmStudio([{ id: 'qwen/qwen3.8-27b', type: 'llm', state: 'loaded', max_context_length: 262144, loaded_context_length: 32768 }], '<think>plan</think>\nThe summary.');
+  const result = await completeText({ provider: 'lmstudio', model: 'qwen/qwen3.8-27b', baseUrl: base }, [{ role: 'user', content: 'Summarize.' }], {}, fetcher);
+  expect(result).toMatchObject({ text: 'The summary.', provider: 'lmstudio', model: 'qwen/qwen3.8-27b' });
+  expect(calls).toContain(`POST ${base}/chat/completions`);
+});
+
+test('a transcript larger than the loaded context is refused before sending', async () => {
+  const { fetcher, calls } = fakeLmStudio([{ id: 'small', type: 'llm', state: 'loaded', max_context_length: 262144, loaded_context_length: 4096 }]);
+  const long = 'word '.repeat(20000);
+  await expect(completeText({ provider: 'lmstudio', model: 'small', baseUrl: base }, [{ role: 'user', content: long }], {}, fetcher)).rejects.toBeInstanceOf(ContextLimitError);
+  expect(calls.some(call => call.includes('chat/completions'))).toBe(false);
+});
+
+test('a model loaded on demand with too small a context: the answer is discarded, not saved', async () => {
+  const { fetcher } = fakeLmStudio(
+    [{ id: 'jit', type: 'llm', state: 'not-loaded', max_context_length: 262144 }], 'Answer from a cut transcript.',
+    [{ id: 'jit', type: 'llm', state: 'loaded', max_context_length: 262144, loaded_context_length: 4096 }]);
+  await expect(completeText({ provider: 'lmstudio', model: 'jit', baseUrl: base }, [{ role: 'user', content: 'word '.repeat(20000) }], {}, fetcher)).rejects.toBeInstanceOf(ContextLimitError);
+});
+
+test('a model LM Studio does not offer is refused', async () => {
+  const { fetcher } = fakeLmStudio([{ id: 'other', type: 'llm' }]);
+  await expect(completeText({ provider: 'lmstudio', model: 'missing', baseUrl: base }, [{ role: 'user', content: 'x' }], {}, fetcher)).rejects.toThrow('does not offer the model');
+});
