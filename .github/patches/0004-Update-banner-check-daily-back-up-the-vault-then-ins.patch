diff --git a/web/src/components/UpdateBanner.tsx b/web/src/components/UpdateBanner.tsx
new file mode 100644
index 0000000..009c798
--- /dev/null
+++ b/web/src/components/UpdateBanner.tsx
@@ -0,0 +1,51 @@
+import { useEffect, useRef, useState } from 'react'
+import type { Update } from '@tauri-apps/plugin-updater'
+import { Download, Loader2, X } from '@/components/icons'
+import { Button } from '@/components/ui/button'
+import { IconButton } from '@/components/ui/icon-button'
+import { backUpThenInstall, findUpdate, type InstallStage } from '@/lib/app-update'
+import { getRuntime } from '@/lib/runtime'
+import { t } from '@/i18n'
+
+const FIRST_CHECK_MS = 10_000
+const RECHECK_MS = 24 * 60 * 60 * 1000
+
+/** Checks for a signed update shortly after start and once a day; offers a one-click install. */
+export function UpdateBanner() {
+  const [update, setUpdate] = useState<Update | null>(null)
+  const [dismissed, setDismissed] = useState<string | null>(null)
+  const [stage, setStage] = useState<InstallStage | null>(null)
+  const [done, setDone] = useState(false)
+  const [error, setError] = useState('')
+  const busy = useRef(false)
+  const desktop = getRuntime().mode === 'desktop'
+
+  useEffect(() => {
+    if (!desktop) return
+    let stopped = false
+    const look = () => { if (!busy.current) void findUpdate().then(found => { if (!stopped && found) setUpdate(found) }).catch(() => undefined) }
+    const first = window.setTimeout(look, FIRST_CHECK_MS)
+    const daily = window.setInterval(look, RECHECK_MS)
+    return () => { stopped = true; window.clearTimeout(first); window.clearInterval(daily) }
+  }, [desktop])
+
+  if (!desktop || !update || dismissed === update.version) return null
+  const install = async () => {
+    busy.current = true; setError('')
+    try { await backUpThenInstall(update, setStage); setDone(true) }
+    catch (failure) { setError(failure instanceof Error ? failure.message : t('The update could not be installed. Your current version is unchanged.')) }
+    finally { busy.current = false; setStage(null) }
+  }
+  const progress = stage?.percent == null ? '' : ` ${stage.percent}%`
+  return <div role="status" className="flex flex-wrap items-center gap-2 border-b bg-muted/60 px-4 py-2 text-sm">
+    <span className="flex-1">
+      {done ? t('Update installed. Quit and reopen OpenPlod to finish.')
+        : stage?.stage === 'backup' ? t('Backing up your vault before updating…') + progress
+        : stage?.stage === 'download' ? t('Installing…') + progress
+        : error || t('OpenPlod {version} is available. Your vault is backed up automatically before it installs.', { version: update.version })}
+    </span>
+    {!done && !stage && <Button size="sm" onClick={() => void install()}><Download />{t('Install {version}', { version: update.version })}</Button>}
+    {stage && <Loader2 className="animate-spin" />}
+    {!stage && <IconButton label={t('Dismiss update message')} onClick={() => setDismissed(update.version)}><X /></IconButton>}
+  </div>
+}
