+++ b/web/src/lib/app-update.ts
@@ -0,0 +1,32 @@
+import type { Update } from '@tauri-apps/plugin-updater'
+import { vaultApi } from './vault-api'
+
+/**
+ * Desktop updates. The updater plugin verifies every package against the public key built into
+ * the app and refuses unsigned or tampered ones. Installing always makes a vault backup first and
+ * stops, leaving the app unchanged, if that backup fails.
+ */
+export async function findUpdate(): Promise<Update | null> {
+  const { check } = await import('@tauri-apps/plugin-updater')
+  return check()
+}
+
+export type InstallStage = { stage: 'backup'; percent: number | null } | { stage: 'download'; percent: number | null }
+
+export async function backUpThenInstall(update: Update, onStage: (stage: InstallStage) => void): Promise<string> {
+  onStage({ stage: 'backup', percent: null })
+  const started = await vaultApi.createBackup({})
+  const finished = await vaultApi.wait(started.id, operation => {
+    const progress = operation.progress
+    onStage({ stage: 'backup', percent: progress?.totalBytes ? Math.round(progress.bytes / progress.totalBytes * 100) : null })
+  })
+  if (finished.state !== 'complete') throw new Error(finished.error || 'The vault backup failed, so the update was not installed.')
+  const backupPath = String((finished.result as { path?: unknown } | undefined)?.path ?? '')
+  let total = 0, received = 0
+  onStage({ stage: 'download', percent: null })
+  await update.downloadAndInstall(event => {
+    if (event.event === 'Started') total = event.data.contentLength ?? 0
+    if (event.event === 'Progress') { received += event.data.chunkLength; onStage({ stage: 'download', percent: total ? Math.round(received / total * 100) : null }) }
+  })
+  return backupPath
+}
