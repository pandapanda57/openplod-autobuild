+//! "Show in folder": opens the system file manager on the vault's recordings folder with one
+//! recording's audio file selected. The web app passes only a recording ID; the file is looked up
+//! inside the recordings folder, so the command cannot be pointed at any other location.
+use std::path::{Path, PathBuf};
+use tauri::Manager;
+
+const AUDIO_EXTENSIONS: [&str; 7] = ["mp3", "m4a", "wav", "ogg", "webm", "aac", "flac"];
+
+/// The recording's audio file (`<id>.<audio extension>`) directly inside `folder`, if present.
+fn find_recording(folder: &Path, recording_id: &str) -> Option<PathBuf> {
+  let folder = folder.canonicalize().ok()?;
+  std::fs::read_dir(&folder).ok()?.flatten().map(|entry| entry.path()).find(|path| {
+    path.is_file()
+      && path.file_stem().and_then(|stem| stem.to_str()) == Some(recording_id)
+      && path.extension().and_then(|ext| ext.to_str()).is_some_and(|ext| AUDIO_EXTENSIONS.contains(&ext.to_ascii_lowercase().as_str()))
+  }).and_then(|path| path.canonicalize().ok()).filter(|path| path.parent() == Some(folder.as_path()))
+}
+
+/// Windows file-manager arguments want a plain path, not the `\\?\` form canonicalize returns.
+#[cfg_attr(not(target_os = "windows"), allow(dead_code))]
+fn plain(path: &Path) -> PathBuf {
+  match path.to_str().and_then(|text| text.strip_prefix(r"\\?\")) {
+    Some(rest) if !rest.starts_with("UNC\\") => PathBuf::from(rest),
+    _ => path.to_path_buf(),
+  }
+}
+
+fn open_with_selection(path: &Path) -> std::io::Result<()> {
+  #[cfg(target_os = "windows")]
+  {
+    use std::os::windows::process::CommandExt;
+    let explorer = std::env::var_os("SystemRoot").map(PathBuf::from).unwrap_or_else(|| PathBuf::from(r"C:\Windows")).join("explorer.exe");
+    // explorer.exe needs the path quoted after "/select,"; Windows paths cannot contain quotes.
+    std::process::Command::new(explorer).raw_arg(format!("/select,\"{}\"", plain(path).display())).spawn()?;
+  }
+  #[cfg(target_os = "macos")]
+  std::process::Command::new("open").arg("-R").arg(path).spawn()?;
+  #[cfg(not(any(target_os = "windows", target_os = "macos")))]
+  std::process::Command::new("xdg-open").arg(path.parent().unwrap_or(path)).spawn()?;
+  Ok(())
+}
+
+#[tauri::command]
+pub fn reveal_recording(app: tauri::AppHandle, recording_id: String) -> Result<(), String> {
+  uuid::Uuid::parse_str(&recording_id).map_err(|_| "Invalid recording ID.")?;
+  let folder = app.path().app_data_dir().map_err(|_| "Vault location is unavailable.")?.join("recordings");
+  let path = find_recording(&folder, &recording_id).ok_or("This recording's audio file is not in the vault folder.")?;
+  open_with_selection(&path).map_err(|_| "Could not open the file manager.".to_string())
+}
+
+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  #[test]
+  fn finds_only_the_recordings_own_audio_file_in_the_folder() {
+    let vault = tempfile::tempdir().unwrap();
+    let id = "51ac305c-fade-48ba-b086-9e68f00295ad";
+    std::fs::write(vault.path().join(format!("{id}.m4a")), b"audio").unwrap();
+    std::fs::write(vault.path().join(format!("{id}.txt")), b"not audio").unwrap();
+    std::fs::create_dir(vault.path().join("originals")).unwrap();
+    let found = find_recording(vault.path(), id).unwrap();
+    assert_eq!(found.file_name().unwrap(), format!("{id}.m4a").as_str());
+    assert!(find_recording(vault.path(), "72be6824-952b-42e8-b9c2-16cf07084e6a").is_none());
+    assert!(find_recording(&vault.path().join("missing"), id).is_none());
+  }
+
+  #[test]
+  fn plain_paths_drop_only_the_local_verbatim_prefix() {
+    assert_eq!(plain(Path::new(r"\\?\C:\Vault\a.m4a")), PathBuf::from(r"C:\Vault\a.m4a"));
+    assert_eq!(plain(Path::new(r"\\?\UNC\server\share\a.m4a")), PathBuf::from(r"\\?\UNC\server\share\a.m4a"));
+  }
+}
