+/**
+ * Deletes one recording from the recorder, only after verifyVaultCopy proves the vault holds it
+ * whole, then lists again to confirm it is gone. Returns alreadyGone when the device no longer
+ * lists it (for example after a retry following a dropped connection).
+ */
+export async function deleteDirectPlaudRecording(sessionId: number,
+  findRecording: (sourceRecordingId: string) => Promise<VaultRecording | undefined>) {
+  if (!Number.isSafeInteger(sessionId) || sessionId < 0 || sessionId > 0xffffffff) throw new Error('Invalid Plaud session ID');
+  return withDevice(async (connection, identity) => {
+    const before = await listPlaudSessions(connection);
+    const target = before.find(session => session.sessionId === sessionId);
+    if (!target) return { sessionId, deleted: false, alreadyGone: true, remaining: before.length };
+    await verifyVaultCopy({ serial: identity.serial, session: target, libraryDirectory: resolve(process.env.OPENPLOD_LIBRARY_PATH || './data/recordings'),
+      recording: await findRecording(`${identity.serial}:${sessionId}`) });
+    await deletePlaudSession(connection, sessionId);
+    const after = await listPlaudSessions(connection);
+    if (after.some(session => session.sessionId === sessionId)) throw new Error('The recorder still lists this recording after the delete. Refresh and check before retrying.');
+    return { sessionId, deleted: true, alreadyGone: false, remaining: after.length };
+  });
+}
