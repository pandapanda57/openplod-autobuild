+import { afterEach, beforeEach, expect, test } from 'bun:test';
+import { createHash } from 'node:crypto';
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { buildDeleteRequest, parseDeleteReply } from './plaud-protocol';
+import { deletePlaudSession } from './plaud-transfer';
+import { verifyVaultCopy, type VaultRecording } from './plaud-delete';
+
+const serial = '0011223344556677';
+const session = { sessionId: 1794594645, size: 6, scene: 0, timezone: 0 };
+const original = Buffer.from([1, 2, 3, 4, 5, 6]);
+let library = '';
+let recording: VaultRecording;
+
+function reply(sessionId: number, status: number) {
+  const packet = Buffer.alloc(8);
+  packet[0] = 1; packet.writeUInt16LE(31, 1); packet.writeUInt32LE(sessionId, 3); packet[7] = status;
+  return packet;
+}
+
+beforeEach(async () => {
+  library = await mkdtemp(join(tmpdir(), 'openplod-delete-'));
+  recording = { id: 'rec-1', filePath: join(library, 'rec-1.m4a'), sourceRecordingId: `${serial}:${session.sessionId}`, retentionState: 'active' };
+  await writeFile(recording.filePath, Buffer.from('audio'));
+  const originals = join(library, 'originals', recording.id);
+  await mkdir(originals, { recursive: true });
+  await writeFile(join(originals, 'device-original.plaud'), original);
+  await writeFile(join(originals, 'provenance.json'), JSON.stringify({
+    serial, session, originalSha256: createHash('sha256').update(original).digest('hex'),
+  }));
+});
+afterEach(async () => { await rm(library, { recursive: true, force: true }); });
+
+test('delete request carries the session ID little-endian after opcode 30', () => {
+  expect(buildDeleteRequest(0x01020304).toString('hex')).toBe('011e0004030201');
+  expect(() => buildDeleteRequest(-1)).toThrow();
+  expect(parseDeleteReply(reply(7, 0))).toEqual({ sessionId: 7, status: 0 });
+  expect(() => parseDeleteReply(Buffer.from('011f00', 'hex'))).toThrow('Invalid delete response');
+});
+
+test('delete waits for the matching reply and skips unrelated packets', async () => {
+  const sent: Buffer[] = []; const packets = [Buffer.from('011a00', 'hex'), reply(7, 0)];
+  await deletePlaudSession({ write: async bytes => { sent.push(Buffer.from(bytes)); }, packet: async () => packets.shift()! }, 7);
+  expect(sent.map(bytes => bytes.toString('hex'))).toEqual(['011e0007000000']);
+});
+
+test('delete rejects a refusal, a reply for another recording, and a silent device', async () => {
+  const one = (packet: Buffer) => ({ write: async () => {}, packet: async () => packet });
+  await expect(deletePlaudSession(one(reply(7, 3)), 7)).rejects.toThrow('refused');
+  await expect(deletePlaudSession(one(reply(8, 0)), 7)).rejects.toThrow('different recording');
+  await expect(deletePlaudSession({ write: async () => {}, packet: async () => { throw new Error('Packet timeout'); } }, 7)).rejects.toThrow('timeout');
+});
+
+test('a whole, active vault copy passes verification', async () => {
+  await verifyVaultCopy({ serial, session, recording, libraryDirectory: library });
+});
+
+test('verification refuses anything short of a whole vault copy', async () => {
+  const check = (changes: Partial<{ recording: VaultRecording | undefined; size: number; serial: string }>) =>
+    verifyVaultCopy({ serial: changes.serial ?? serial, session: { ...session, size: changes.size ?? session.size },
+      recording: 'recording' in changes ? changes.recording : recording, libraryDirectory: library });
+  await expect(check({ recording: undefined })).rejects.toThrow('not been imported');
+  await expect(check({ recording: { ...recording, sourceRecordingId: `${serial}:1` } })).rejects.toThrow('not been imported');
+  await expect(check({ recording: { ...recording, retentionState: 'trash' } })).rejects.toThrow('Trash');
+  await expect(check({ size: 7 })).rejects.toThrow('vault copy has 6');
+  await expect(check({ serial: 'FFFFFFFFFFFFFFFF', recording: { ...recording, sourceRecordingId: `FFFFFFFFFFFFFFFF:${session.sessionId}` } })).rejects.toThrow('does not match');
+  await writeFile(join(library, 'originals', recording.id, 'device-original.plaud'), Buffer.from([9, 9, 9, 9, 9, 9]));
+  await expect(check({})).rejects.toThrow('changed since import');
+  await writeFile(recording.filePath, Buffer.alloc(0));
+  await expect(check({})).rejects.toThrow('missing or empty');
+});
+
+test('verification refuses when the original or import record is missing', async () => {
+  await rm(join(library, 'originals', recording.id, 'provenance.json'));
+  await expect(verifyVaultCopy({ serial, session, recording, libraryDirectory: library })).rejects.toThrow('import record');
+  await rm(join(library, 'originals', recording.id), { recursive: true });
+  await expect(verifyVaultCopy({ serial, session, recording, libraryDirectory: library })).rejects.toThrow('no copy');
+});
