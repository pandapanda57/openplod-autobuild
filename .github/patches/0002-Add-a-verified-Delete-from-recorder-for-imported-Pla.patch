+// Deleting the recorder's copy is irreversible, so it is allowed only from this computer and
+// only for a recording whose vault copy verifies (see verifyVaultCopy).
+app.post('/device-delete', async c => {
+  c.header('Cache-Control', 'no-store');
+  if (!localOwner(c)) return c.json({ success: false, error: 'Deleting from the recorder must happen on this computer.' }, 403);
+  let body: { sessionId?: unknown; confirm?: unknown };
+  try { body = await c.req.json(); } catch { body = {}; }
+  if (body.confirm !== true || !Number.isSafeInteger(body.sessionId)) return c.json({ success: false, error: 'A session ID and delete confirmation are required' }, 400);
+  if (importJob?.state === 'running') return c.json({ success: false, error: 'A Plaud import is running. Delete after it finishes.' }, 409);
+  try {
+    const result = await deleteDirectPlaudRecording(body.sessionId as number, async sourceRecordingId => {
+      const rows = await db.select({ id: recordings.id, filePath: recordings.filePath, sourceRecordingId: recordings.sourceRecordingId, retentionState: recordings.retentionState })
+        .from(recordings).where(and(eq(recordings.sourceProvider, 'plaud'), eq(recordings.sourceRecordingId, sourceRecordingId)));
+      return rows.find(row => row.retentionState === 'active') ?? rows[0];
+    });
+    return c.json({ success: true, data: result });
+  } catch (error) {
+    return c.json({ success: false, error: error instanceof Error ? error.message : 'Delete from the recorder failed' }, 409);
+  }
+});
+
