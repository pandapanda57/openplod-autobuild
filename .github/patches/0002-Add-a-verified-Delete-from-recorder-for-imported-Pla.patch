+/** syncFileDel in the APK: removes one finished recording from the device. */
+export function buildDeleteRequest(sessionId: number): Buffer {
+  return command(PLAUD_COMMAND.deleteFile, uint32(sessionId));
+}
+
+/** Reply to deleteFile on protocol 7 and later: session ID echoed at 3, status at 7 (0 = deleted). */
+export function parseDeleteReply(packet: Uint8Array) {
+  const bytes = Buffer.from(packet);
+  if (bytes.length < 8 || bytes[0] !== 1 || bytes.readUInt16LE(1) !== PLAUD_COMMAND.deleteFileReply) {
+    throw new Error('Invalid delete response');
+  }
+  return { sessionId: bytes.readUInt32LE(3), status: bytes[7]! };
+}
