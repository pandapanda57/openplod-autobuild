+/** Sends one delete and waits for the matching reply. Callers must verify the vault copy first. */
+export async function deletePlaudSession(connection: PlaudPackets, sessionId: number) {
+  await connection.write(buildDeleteRequest(sessionId));
+  const deadline = Date.now() + 15000;
+  while (Date.now() < deadline) {
+    const packet = await connection.packet(deadline - Date.now());
+    if (packet.length < 3 || packet[0] !== 1 || packet.readUInt16LE(1) !== PLAUD_COMMAND.deleteFileReply) continue;
+    const reply = parseDeleteReply(packet);
+    if (reply.sessionId !== sessionId) throw new Error('Delete reply named a different recording');
+    if (reply.status !== 0) throw new Error(`The recorder refused to delete the recording (status ${reply.status})`);
+    return;
+  }
+  throw new Error('Delete confirmation timed out; refresh the recording list before retrying');
+}
