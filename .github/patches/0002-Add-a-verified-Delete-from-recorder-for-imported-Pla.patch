new file mode 100644
index 0000000..126fb1e
--- /dev/null
+++ b/src/sync/plaud-delete.ts
@@ -0,0 +1,58 @@
+import { createHash } from 'node:crypto';
+import { createReadStream } from 'node:fs';
+import { readFile, stat } from 'node:fs/promises';
+import { join } from 'node:path';
+import type { PlaudSessionEntry } from './plaud-protocol';
+
+/** The vault row a device recording was imported as. */
+export interface VaultRecording {
+  id: string;
+  filePath: string;
+  sourceRecordingId: string | null;
+  retentionState: string | null;
+}
+
+async function sha256(path: string): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const hash = createHash('sha256');
+    createReadStream(path).on('data', chunk => hash.update(chunk)).on('error', reject).on('end', () => resolve(hash.digest('hex')));
+  });
+}
+
+async function fileSize(path: string): Promise<number | null> {
+  try { const info = await stat(path); return info.isFile() ? info.size : null; } catch { return null; }
+}
+
+/**
+ * Proves the vault holds a whole copy of this device recording before the device's copy is
+ * deleted. Throws with a plain reason when any check fails; deleting is then refused.
+ * Checks: imported from this recorder and session, still active (not in Trash), playable file
+ * present, and the device's encrypted original kept byte for byte (size and SHA-256 recorded
+ * at import time match, and the size still matches what the device lists now).
+ */
+export async function verifyVaultCopy(params: {
+  serial: string;
+  session: PlaudSessionEntry;
+  recording: VaultRecording | undefined;
+  libraryDirectory: string;
+}): Promise<void> {
+  const { serial, session, recording } = params;
+  const source = `${serial}:${session.sessionId}`;
+  if (!recording || recording.sourceRecordingId !== source) throw new Error('This recording has not been imported into the vault, so it stays on the recorder.');
+  if (recording.retentionState !== 'active') throw new Error('The vault copy is in Trash or being removed. Restore it before deleting the recorder copy.');
+  if (!((await fileSize(recording.filePath)) ?? 0)) throw new Error('The vault audio file is missing or empty, so the recorder copy is kept.');
+  const originals = join(params.libraryDirectory, 'originals', recording.id);
+  const original = join(originals, 'device-original.plaud');
+  const originalSize = await fileSize(original);
+  if (originalSize === null) throw new Error('The vault has no copy of the recorder\'s original file, so the recorder copy is kept.');
+  if (originalSize !== session.size) throw new Error(`The recorder lists ${session.size} bytes but the vault copy has ${originalSize}. The recorder copy is kept.`);
+  let provenance: { serial?: unknown; session?: { sessionId?: unknown; size?: unknown }; originalSha256?: unknown };
+  try { provenance = JSON.parse(await readFile(join(originals, 'provenance.json'), 'utf8')); }
+  catch { throw new Error('The vault\'s import record could not be read, so the recorder copy is kept.'); }
+  if (provenance.serial !== serial || provenance.session?.sessionId !== session.sessionId || provenance.session?.size !== session.size) {
+    throw new Error('The vault\'s import record does not match this recording. The recorder copy is kept.');
+  }
+  if (typeof provenance.originalSha256 !== 'string' || provenance.originalSha256 !== await sha256(original)) {
+    throw new Error('The vault copy of the original file has changed since import. The recorder copy is kept.');
+  }
+}
