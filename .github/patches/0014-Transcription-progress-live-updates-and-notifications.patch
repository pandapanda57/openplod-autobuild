+++ b/web/src/components/JobProgress.tsx
@@ -0,0 +1,68 @@
+import { useState } from 'react'
+import { AlertCircle, Loader2, X } from '@/components/icons'
+import { Button } from '@/components/ui/button'
+import { aiSettingsApi } from '@/lib/ai-settings'
+import { formatSpan, jobProgress, recordingStateLabel, refreshActivity, useActivity, type ActivityJob, type RecordingState } from '@/lib/activity'
+import { t } from '@/i18n'
+
+const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`
+
+function ProgressBar({ percent }: { percent: number | null }) {
+  return (
+    <div className="h-2 w-full overflow-hidden rounded-full bg-muted" role="progressbar" aria-valuemin={0} aria-valuemax={100} {...(percent !== null ? { 'aria-valuenow': percent } : {})}>
+      {percent !== null
+        ? <div className="h-full rounded-full bg-primary transition-[width] duration-500" style={{ width: `${Math.max(2, percent)}%` }} />
+        : <div className="h-full w-full animate-pulse rounded-full bg-primary/60" />}
+    </div>
+  )
+}
+
+/** Progress for a queued or running transcription: step, bar, percent, elapsed, time left, Cancel. */
+export function JobProgressPanel({ job, compact = false }: { job: ActivityJob; compact?: boolean }) {
+  const { now } = useActivity()
+  const [cancelling, setCancelling] = useState(false)
+  const [error, setError] = useState('')
+  const p = jobProgress(job, now)
+  const cancel = async () => {
+    setCancelling(true); setError('')
+    try { await aiSettingsApi.cancel(job.id); refreshActivity() } catch (e) { setError(e instanceof Error ? e.message : String(e)) } finally { setCancelling(false) }
+  }
+  const details = [
+    p.percent !== null ? `${p.percent}%` : null,
+    p.elapsedSec !== null ? t('{time} elapsed', { time: clock(p.elapsedSec) }) : null,
+    p.remainingSec !== null ? t('about {span} left', { span: formatSpan(p.remainingSec) }) : null,
+  ].filter(Boolean).join(' · ')
+  return (
+    <div className={`grid gap-3 rounded-lg border bg-card p-4 text-left ${compact ? '' : 'w-full max-w-md'}`} role="status" aria-live="polite">
+      <div className="flex items-center gap-2">
+        <Loader2 className="h-4 w-4 shrink-0 animate-spin text-primary" />
+        <strong className="text-sm">{p.queued ? t('Queued for transcription') : t('Transcribing')}</strong>
+        <Button size="sm" variant="ghost" className="ml-auto" disabled={cancelling} onClick={() => void cancel()}><X />{t('Cancel')}</Button>
+      </div>
+      {p.queued
+        ? <p className="text-xs text-muted-foreground">{t('Starts when the transcription before it finishes.')}</p>
+        : <>
+            <p className="text-sm">{p.step !== null && p.steps !== null ? t('Step {step} of {steps}: {name}', { step: p.step, steps: p.steps, name: p.stepLabel }) : p.stepLabel}</p>
+            <ProgressBar percent={p.percent} />
+            {details && <p className="text-xs text-muted-foreground">{details}</p>}
+          </>}
+      {error && <p className="flex items-center gap-1 text-xs text-destructive"><AlertCircle className="h-3 w-3" />{error}</p>}
+    </div>
+  )
+}
+
+/** Small status label for a recording row: Queued, Transcribing 42%, Failed, Not transcribed. */
+export function RecordingStateChip({ state, job, onRetry }: { state: RecordingState; job?: ActivityJob; onRetry?: () => void }) {
+  const { now } = useActivity()
+  if (state === 'complete') return null
+  const percent = job && state === 'transcribing' ? jobProgress(job, now).percent : null
+  const tone = state === 'failed' ? 'border-destructive/40 text-destructive' : state === 'not-transcribed' ? 'text-muted-foreground' : 'border-primary/40 text-primary'
+  return (
+    <span className={`inline-flex items-center gap-1 whitespace-nowrap rounded-full border px-2 py-0.5 text-[11px] ${tone}`} title={job?.error || undefined}>
+      {(state === 'transcribing' || state === 'queued' || state === 'summarizing') && <Loader2 className="h-3 w-3 animate-spin" />}
+      {state === 'failed' && <AlertCircle className="h-3 w-3" />}
+      {recordingStateLabel(state)}{percent !== null ? ` ${percent}%` : ''}
+      {state === 'failed' && onRetry && <button type="button" className="ml-1 underline" onClick={event => { event.stopPropagation(); onRetry() }}>{t('Retry')}</button>}
+    </span>
+  )
+}
