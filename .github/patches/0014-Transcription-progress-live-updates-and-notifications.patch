@@ -0,0 +1,50 @@
+import { describe, expect, test } from 'bun:test'
+import { activeJobFor, failedJobFor, jobProgress, progressText, recordingState, type ActivityJob } from './activity'
+import { displayRecordingName, plaudSessionStart } from './api'
+
+const started = '2026-11-22T08:00:00.000Z'
+const at = (seconds: number) => Date.parse(started) + seconds * 1000
+const job = (over: Partial<ActivityJob>): ActivityJob => ({ id: 'j1', recordingId: 'r1', status: 'running', startedAt: started, ...over })
+
+describe('transcription progress', () => {
+  test('local pipeline step 1 gives a percent and, after 15 s, the time left', () => {
+    const running = job({ checkpoint: { phase: 'pipeline step 1 of 3: speech to text', progress: { done: 25, total: 100 } } })
+    expect(jobProgress(running, at(60))).toMatchObject({ step: 1, steps: 3, stepLabel: 'Speech to text', percent: 25, elapsedSec: 60, remainingSec: 180 })
+    expect(jobProgress(running, at(10)).remainingSec).toBeNull()
+    expect(progressText(running, at(60))).toBe('Speech to text 25% · about 3 min left')
+  })
+  test('later pipeline steps show their name without a percent', () => {
+    const p = jobProgress(job({ checkpoint: { phase: 'pipeline step 2 of 3: speaker labels', progress: { done: 0, total: 100 } } }), at(90))
+    expect(p).toMatchObject({ step: 2, stepLabel: 'Speaker labels', percent: null, remainingSec: null })
+  })
+  test('cloud engines report chunks as a percent; queued jobs say Queued', () => {
+    expect(jobProgress(job({ checkpoint: { phase: 'transcribing', progress: { done: 1, total: 4 } } }), at(30)).percent).toBe(25)
+    expect(progressText(job({ status: 'pending', startedAt: undefined }))).toBe('Queued')
+  })
+})
+
+describe('recording state', () => {
+  const recording = { id: 'r1', status: 'pending', hasTranscript: false }
+  test('"pending" without a job means not transcribed; with a job, queued or transcribing', () => {
+    expect(recordingState(recording, [])).toBe('not-transcribed')
+    expect(recordingState(recording, [job({ status: 'pending' })])).toBe('queued')
+    expect(recordingState(recording, [job({})])).toBe('transcribing')
+    expect(recordingState({ ...recording, status: 'complete', hasTranscript: true }, [])).toBe('complete')
+  })
+  test('the latest ended job decides failed; comparison runs never count', () => {
+    const failed = job({ id: 'a', status: 'failed', completedAt: '2026-11-22T08:05:00.000Z', error: 'boom' })
+    expect(recordingState(recording, [failed])).toBe('failed')
+    expect(failedJobFor([failed, job({ id: 'b', status: 'complete', completedAt: '2026-11-22T08:06:00.000Z' })], 'r1')).toBeUndefined()
+    expect(activeJobFor([job({ dedupeKey: 'compare:x' })], 'r1')).toBeUndefined()
+  })
+})
+
+describe('recording names', () => {
+  test('a file named by its Plaud session shows the recording time; other names are kept', () => {
+    const start = plaudSessionStart('SN0000TEST:1795000000', 'Plaud-1795000000.m4a')
+    expect(start?.toISOString()).toBe('2026-11-18T11:06:40.000Z')
+    expect(displayRecordingName('Plaud-1795000000.m4a', 'SN0000TEST:1795000000')).not.toContain('1795000000')
+    expect(displayRecordingName('Weekly sync.m4a', null)).toBe('Weekly sync')
+    expect(displayRecordingName('team_review-notes.ogg', null)).toBe('team review notes')
+  })
+})
diff --git a/web/src/lib/activity.ts b/web/src/lib/activity.ts
new file mode 100644
index 0000000..d541912
--- /dev/null
+++ b/web/src/lib/activity.ts
@@ -0,0 +1,288 @@
+/**
+ * Live processing activity: one poller for the job list that every screen shares.
+ *
+ * - Polls `/api/jobs?active=1` every 2.5 s while a job is queued or running, every 15 s otherwise.
+ * - When a job ends, fires DATA_CHANGED (lists, counts and pages reload) and adds a notification.
+ * - On the desktop app it also shows progress on the taskbar button and in the tray tooltip, and a
+ *   Windows notification when a transcription ends while OpenPlod is not in front.
+ */
+import { useSyncExternalStore } from 'react'
+import { apiUrl, authenticatedHeaders, getRuntime } from '@/lib/runtime'
+import { displayRecordingName } from '@/lib/api'
+import { t } from '@/i18n'
+
+export const DATA_CHANGED = 'openplod:data-changed'
+
+export type ActivityJob = {
+  id: string
+  recordingId?: string
+  provider?: string
+  status: 'pending' | 'running' | 'complete' | 'failed' | 'cancelled'
+  error?: string
+  createdAt?: string
+  startedAt?: string
+  completedAt?: string
+  /** Set for extra comparison runs, which never change the recording itself. */
+  dedupeKey?: string
+  checkpoint?: { phase?: string; progress?: { done: number; total: number } }
+  recordingFilename?: string | null
+  sourceRecordingId?: string | null
+}
+
+export type ActivityNotice = {
+  id: string
+  kind: 'transcribed' | 'failed' | 'imported'
+  title: string
+  detail?: string
+  recordingId?: string
+  at: number
+  read: boolean
+}
+
+type Snapshot = { jobs: ActivityJob[]; notices: ActivityNotice[]; now: number; loaded: boolean }
+
+const NOTICES_KEY = 'openplod.activity.notices'
+const MAX_NOTICES = 30
+const FAST_MS = 2500
+const IDLE_MS = 15000
+const ACTIVE = new Set(['pending', 'running'])
+
+function readNotices(): ActivityNotice[] {
+  try {
+    const rows = JSON.parse(localStorage.getItem(NOTICES_KEY) || '[]')
+    return Array.isArray(rows) ? rows.filter(row => row && typeof row.id === 'string' && typeof row.title === 'string').slice(0, MAX_NOTICES) : []
+  } catch { return [] }
+}
+
+let snapshot: Snapshot = { jobs: [], notices: readNotices(), now: Date.now(), loaded: false }
+const listeners = new Set<() => void>()
+let previous = new Map<string, ActivityJob['status']>()
+let started = false
+let timer: number | null = null
+let polling = false
+
+function publish(next: Partial<Snapshot>) {
+  snapshot = { ...snapshot, ...next }
+  if (next.notices) {
+    try { localStorage.setItem(NOTICES_KEY, JSON.stringify(snapshot.notices)) } catch { /* Notices still show for this session. */ }
+  }
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener) } }
+const getSnapshot = () => snapshot
+
+/** The shared activity state; components re-render when it changes. */
+export function useActivity(): Snapshot {
+  return useSyncExternalStore(subscribe, getSnapshot)
+}
+
+export function addNotice(notice: Omit<ActivityNotice, 'id' | 'at' | 'read'>) {
+  const row: ActivityNotice = { ...notice, id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`, at: Date.now(), read: false }
+  publish({ notices: [row, ...snapshot.notices].slice(0, MAX_NOTICES) })
+}
+
+export function markNoticesRead() {
+  if (snapshot.notices.some(row => !row.read)) publish({ notices: snapshot.notices.map(row => ({ ...row, read: true })) })
+}
+
+export function clearNotices() {
+  publish({ notices: [] })
+}
+
+/** Name to show for the recording a job belongs to. */
+export function jobTitle(job: ActivityJob): string {
+  return job.recordingFilename || job.sourceRecordingId ? displayRecordingName(job.recordingFilename, job.sourceRecordingId) : t('A recording')
+}
+
+/** The queued or running job for a recording, ignoring extra comparison runs. */
+export function activeJobFor(jobs: ActivityJob[], recordingId: string | undefined): ActivityJob | undefined {
+  if (!recordingId) return undefined
+  return jobs.find(job => job.recordingId === recordingId && !job.dedupeKey && job.status === 'running')
+    ?? jobs.find(job => job.recordingId === recordingId && !job.dedupeKey && job.status === 'pending')
+}
+
+/** The most recent failed job for a recording, when nothing newer is queued. */
+export function failedJobFor(jobs: ActivityJob[], recordingId: string | undefined): ActivityJob | undefined {
+  if (!recordingId || activeJobFor(jobs, recordingId)) return undefined
+  const ended = jobs.filter(job => job.recordingId === recordingId && !job.dedupeKey && !ACTIVE.has(job.status))
+    .sort((a, b) => Date.parse(b.completedAt || '') - Date.parse(a.completedAt || ''))
+  return ended[0]?.status === 'failed' ? ended[0] : undefined
+}
+
+export type JobProgress = {
+  queued: boolean
+  /** Step number and count for the local pipeline; null for other engines. */
+  step: number | null
+  steps: number | null
+  stepLabel: string
+  /** Percent of the current step, or null when the step reports none. */
+  percent: number | null
+  elapsedSec: number | null
+  remainingSec: number | null
+}
+
+const STEP_LABELS: Record<string, () => string> = {
+  'speech to text': () => t('Speech to text'),
+  'speaker labels': () => t('Speaker labels'),
+  merge: () => t('Merging'),
+}
+
+export function jobProgress(job: ActivityJob, now = Date.now()): JobProgress {
+  const phase = job.checkpoint?.phase ?? ''
+  const progress = job.checkpoint?.progress
+  const startedAt = job.startedAt ? Date.parse(job.startedAt) : NaN
+  const elapsedSec = job.status === 'running' && Number.isFinite(startedAt) ? Math.max(0, (now - startedAt) / 1000) : null
+  const pipeline = /^pipeline step (\d+) of (\d+): (.+)$/.exec(phase)
+  let step: number | null = null, steps: number | null = null, stepLabel = job.status === 'pending' ? t('Queued') : t('Transcribing'), percent: number | null = null
+  if (pipeline) {
+    step = Number(pipeline[1]); steps = Number(pipeline[2])
+    stepLabel = STEP_LABELS[pipeline[3]]?.() ?? pipeline[3]
+    // Only speech to text reports a percent; the later steps take seconds.
+    if (step === 1 && progress && progress.total > 0) percent = Math.min(100, Math.round(progress.done / progress.total * 100))
+  } else if (progress && progress.total > 1) {
+    percent = Math.min(100, Math.round(progress.done / progress.total * 100))
+  }
+  const remainingSec = percent !== null && percent >= 3 && percent < 100 && elapsedSec !== null && elapsedSec >= 15
+    ? elapsedSec * (100 - percent) / percent : null
+  return { queued: job.status === 'pending', step, steps, stepLabel, percent, elapsedSec, remainingSec }
+}
+
+/** "42 s", "3 min", "1 h 5 min". */
+export function formatSpan(seconds: number): string {
+  if (seconds < 60) return t('{count} s', { count: Math.max(1, Math.round(seconds)) })
+  const minutes = Math.round(seconds / 60)
+  if (minutes < 60) return t('{count} min', { count: minutes })
+  return t('{hours} h {minutes} min', { hours: Math.floor(minutes / 60), minutes: minutes % 60 })
+}
+
+/** One line for a running or queued job, e.g. "Speech to text 42% · about 3 min left". */
+export function progressText(job: ActivityJob, now = Date.now()): string {
+  const p = jobProgress(job, now)
+  if (p.queued) return t('Queued')
+  const parts = [p.percent !== null ? `${p.stepLabel} ${p.percent}%` : p.stepLabel]
+  if (p.remainingSec !== null) parts.push(t('about {span} left', { span: formatSpan(p.remainingSec) }))
+  return parts.join(' · ')
+}
+
+export type RecordingState = 'queued' | 'transcribing' | 'summarizing' | 'failed' | 'not-transcribed' | 'complete'
+
+/** What a recording's status means once its jobs are known: "pending" alone is ambiguous. */
+export function recordingState(recording: { id: string; status: string; hasTranscript?: boolean; transcriptText?: string }, jobs: ActivityJob[]): RecordingState {
+  const job = activeJobFor(jobs, recording.id)
+  if (job) return job.status === 'running' ? 'transcribing' : 'queued'
+  if (recording.status === 'failed' || failedJobFor(jobs, recording.id)) return 'failed'
+  if (recording.status === 'transcribing') return 'transcribing'
+  if (recording.status === 'summarizing') return 'summarizing'
+  const transcribed = recording.hasTranscript ?? Boolean(recording.transcriptText?.trim())
+  return transcribed ? 'complete' : 'not-transcribed'
+}
+
+export function recordingStateLabel(state: RecordingState): string {
+  return {
+    queued: t('Queued'), transcribing: t('Transcribing'), summarizing: t('Summarizing'), failed: t('Failed'),
+    'not-transcribed': t('Not transcribed'), complete: t('Complete'),
+  }[state]
+}
+
+// ---------------------------------------------------------------------------------------------
+// Polling
+
+async function poll() {
+  if (polling) return
+  polling = true
+  let jobs: ActivityJob[] | null = null
+  try {
+    const response = await fetch(apiUrl('/jobs?active=1'), { headers: authenticatedHeaders(), signal: AbortSignal.timeout(8000) })
+    if (response.ok) {
+      const payload = await response.json()
+      if (payload?.success && Array.isArray(payload.data)) jobs = payload.data as ActivityJob[]
+    }
+  } catch { /* The service may be restarting; the next poll retries. */ }
+  polling = false
+  if (jobs) {
+    const now = Date.now()
+    let changed = false
+    const notices: ActivityNotice[] = []
+    for (const job of jobs) {
+      const before = previous.get(job.id)
+      if (before !== job.status) changed = true
+      if (before && ACTIVE.has(before) && !ACTIVE.has(job.status) && !job.dedupeKey) {
+        if (job.status === 'complete') notices.push({ id: `${job.id}-done`, kind: 'transcribed', title: jobTitle(job), detail: t('Transcript ready'), recordingId: job.recordingId, at: now, read: false })
+        if (job.status === 'failed') notices.push({ id: `${job.id}-failed`, kind: 'failed', title: jobTitle(job), detail: job.error || t('Transcription failed'), recordingId: job.recordingId, at: now, read: false })
+      }
+    }
+    for (const id of previous.keys()) if (!jobs.some(job => job.id === id)) changed = true
+    previous = new Map(jobs.map(job => [job.id, job.status]))
+    const firstLoad = !snapshot.loaded
+    if (firstLoad) changed = false
+    publish({ jobs, now, loaded: true, ...(notices.length ? { notices: [...notices, ...snapshot.notices].slice(0, MAX_NOTICES) } : {}) })
+    if (changed) window.dispatchEvent(new Event(DATA_CHANGED))
+    for (const notice of notices) void notifyDesktop(notice)
+    void syncDesktop(jobs, now)
+  }
+  schedule()
+}
+
+function schedule() {
+  if (timer !== null) window.clearTimeout(timer)
+  const busy = snapshot.jobs.some(job => ACTIVE.has(job.status))
+  timer = window.setTimeout(() => void poll(), busy ? FAST_MS : IDLE_MS)
+}
+
+/** Starts the shared poller once (the app layout calls this). */
+export function startActivity() {
+  if (started) return
+  started = true
+  void poll()
+}
+
+/** Polls now, e.g. right after a transcription was queued. */
+export function refreshActivity() {
+  if (!started) { startActivity(); return }
+  void poll()
+}
+
+// ---------------------------------------------------------------------------------------------
+// Desktop: taskbar progress, tray tooltip, Windows notifications
+
+let lastBar = ''
+let lastTooltip = ''
+
+async function syncDesktop(jobs: ActivityJob[], now: number) {
+  if (getRuntime().mode !== 'desktop') return
+  const running = jobs.find(job => job.status === 'running' && !job.dedupeKey)
+  const queued = jobs.filter(job => job.status === 'pending' && !job.dedupeKey).length
+  const progress = running ? jobProgress(running, now) : null
+  const bar = running ? (progress?.percent !== null && progress?.percent !== undefined ? `normal:${progress.percent}` : 'indeterminate') : queued ? 'indeterminate' : 'none'
+  if (bar !== lastBar) {
+    lastBar = bar
+    try {
+      const { getCurrentWindow, ProgressBarStatus } = await import('@tauri-apps/api/window')
+      await getCurrentWindow().setProgressBar(bar === 'none' ? { status: ProgressBarStatus.None }
+        : bar === 'indeterminate' ? { status: ProgressBarStatus.Indeterminate }
+        : { status: ProgressBarStatus.Normal, progress: progress?.percent ?? 0 })
+    } catch { /* Older shells without the permission: no taskbar progress. */ }
+  }
+  let tooltip = 'OpenPlod'
+  if (running) tooltip = `OpenPlod: ${jobTitle(running)}, ${progressText(running, now)}`
+  if (queued) tooltip += running ? `, ${t('{count} queued', { count: queued })}` : `: ${t('{count} queued', { count: queued })}`
+  tooltip = tooltip.length > 120 ? `${tooltip.slice(0, 119)}…` : tooltip
+  if (tooltip !== lastTooltip) {
+    lastTooltip = tooltip
+    try {
+      const { TrayIcon } = await import('@tauri-apps/api/tray')
+      await (await TrayIcon.getById('openplod'))?.setTooltip(tooltip)
+    } catch { /* No tray (or no permission): nothing to update. */ }
+  }
+}
+
+async function notifyDesktop(notice: ActivityNotice) {
+  if (getRuntime().mode !== 'desktop' || document.hasFocus()) return
+  try {
+    const notification = await import('@tauri-apps/plugin-notification')
+    let granted = await notification.isPermissionGranted()
+    if (!granted) granted = (await notification.requestPermission()) === 'granted'
+    if (granted) notification.sendNotification({ title: notice.kind === 'failed' ? t('Transcription failed') : t('Transcript ready'), body: notice.kind === 'failed' ? `${notice.title}: ${notice.detail ?? ''}` : notice.title })
+  } catch { /* Notifications are optional. */ }
+}
